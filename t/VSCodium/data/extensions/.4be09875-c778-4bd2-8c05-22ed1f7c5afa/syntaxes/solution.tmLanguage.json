{
  "name": "Visual Studio Solution",
  "scopeName": "source.solution",
  "fileTypes": ["sln"],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#header"
    },
    {
      "include": "#project"
    },
    {
      "include": "#global-section"
    },
    {
      "include": "#section-content"
    },
    {
      "include": "#guids"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "match": "^\\s*#.*$",
          "name": "comment.line.number-sign.solution"
        }
      ]
    },
    "header": {
      "patterns": [
        {
          "match": "^(Microsoft Visual Studio Solution File, Format Version)\\s+([0-9.]+)\\s*$",
          "captures": {
            "1": {
              "name": "keyword.control.solution"
            },
            "2": {
              "name": "constant.numeric.solution"
            }
          }
        },
        {
          "match": "^#\\s*(Visual Studio Version|VisualStudioVersion|MinimumVisualStudioVersion)\\s*=\\s*([0-9.]+)\\s*$",
          "captures": {
            "1": {
              "name": "support.type.solution"
            },
            "2": {
              "name": "constant.numeric.solution"
            }
          }
        }
      ]
    },
    "project": {
      "patterns": [
        {
          "begin": "^(Project)\\s*(\\()\\s*(\")",
          "end": "^(EndProject)\\s*$",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.solution"
            },
            "2": {
              "name": "punctuation.definition.parameters.begin.solution"
            },
            "3": {
              "name": "punctuation.definition.string.begin.solution"
            }
          },
          "endCaptures": {
            "1": {
              "name": "keyword.control.solution"
            }
          },
          "patterns": [
            {
              "include": "#project-line"
            },
            {
              "include": "#project-section"
            }
          ]
        }
      ]
    },
    "project-line": {
      "patterns": [
        {
          "match": "(\\{[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}\\})",
          "name": "constant.language.guid.solution"
        },
        {
          "match": "\"([^\"]+)\"",
          "captures": {
            "1": {
              "name": "string.quoted.double.solution"
            }
          }
        },
        {
          "match": "=",
          "name": "keyword.operator.assignment.solution"
        },
        {
          "match": ",",
          "name": "punctuation.separator.comma.solution"
        }
      ]
    },
    "project-section": {
      "patterns": [
        {
          "begin": "^\\s*(ProjectSection)\\s*\\(\\s*([^)]+)\\s*\\)\\s*=\\s*(\\w+)\\s*$",
          "end": "^\\s*(EndProjectSection)\\s*$",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.solution"
            },
            "2": {
              "name": "entity.name.section.solution"
            },
            "3": {
              "name": "constant.language.solution"
            }
          },
          "endCaptures": {
            "1": {
              "name": "keyword.control.solution"
            }
          },
          "patterns": [
            {
              "include": "#section-content"
            }
          ]
        }
      ]
    },
    "global-section": {
      "patterns": [
        {
          "begin": "^(Global)\\s*$",
          "end": "^(EndGlobal)\\s*$",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.solution"
            }
          },
          "endCaptures": {
            "1": {
              "name": "keyword.control.solution"
            }
          },
          "patterns": [
            {
              "include": "#global-subsection"
            }
          ]
        }
      ]
    },
    "global-subsection": {
      "patterns": [
        {
          "begin": "^\\s*(GlobalSection)\\s*\\(\\s*([^)]+)\\s*\\)\\s*=\\s*(\\w+)\\s*$",
          "end": "^\\s*(EndGlobalSection)\\s*$",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.solution"
            },
            "2": {
              "name": "entity.name.section.solution"
            },
            "3": {
              "name": "constant.language.solution"
            }
          },
          "endCaptures": {
            "1": {
              "name": "keyword.control.solution"
            }
          },
          "patterns": [
            {
              "include": "#section-content"
            }
          ]
        }
      ]
    },
    "section-content": {
      "patterns": [
        {
          "match": "^\\s*([^=]+)\\s*=\\s*(.+)\\s*$",
          "captures": {
            "1": {
              "name": "variable.other.property.solution",
              "patterns": [
                {
                  "include": "#guids"
                },
                {
                  "include": "#strings"
                }
              ]
            },
            "2": {
              "name": "string.unquoted.solution",
              "patterns": [
                {
                  "include": "#guids"
                },
                {
                  "include": "#strings"
                }
              ]
            }
          }
        }
      ]
    },
    "guids": {
      "patterns": [
        {
          "match": "\\{[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}\\}",
          "name": "constant.language.guid.solution"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "match": "\"([^\"]*)\"",
          "captures": {
            "0": {
              "name": "string.quoted.double.solution"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(preProject|postProject|preSolution|postSolution)\\b",
          "name": "constant.language.solution"
        },
        {
          "match": "\\b(Debug|Release|Any CPU|AnyCPU|x86|x64|ARM|ARM64|Mixed Platforms)\\b",
          "name": "constant.language.configuration.solution"
        },
        {
          "match": "\\b(ActiveCfg|Build\\.0|Deploy\\.0)\\b",
          "name": "support.type.property-name.solution"
        }
      ]
    }
  }
}
