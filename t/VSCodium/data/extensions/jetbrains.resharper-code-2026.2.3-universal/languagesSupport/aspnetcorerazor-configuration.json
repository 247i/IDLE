{
	"comments": {
		"blockComment": [
			"@*",
			"*@"
		]
	},
	"brackets": [
		[
			"<!--",
			"-->"
		],
		[
			"<",
			">"
		],
		[
			"{",
			"}"
		],
		[
			"(",
			")"
		]
	],
	"autoClosingPairs": [
		{
			"open": "{",
			"close": "}"
		},
		{
			"open": "[",
			"close": "]"
		},
		{
			"open": "(",
			"close": ")"
		},
		{
			"open": "'",
			"close": "'"
		},
		{
			"open": "\"",
			"close": "\""
		},
		{
			"open": "@*",
			"close": "*@"
		}
	],
	"surroundingPairs": [
		{
			"open": "'",
			"close": "'"
		},
		{
			"open": "\"",
			"close": "\""
		},
		{
			"open": "<",
			"close": ">"
		}
	],
	"onEnterRules": [
		{
			"beforeText": "<(?!(?:area|base|br|col|command|embed|hr|img|input|keygen|link|menuitem|meta|param|source|track|wbr))([_:\\w][_:\\w-.\\d]*)([^/>]*(?!/)>)[^<]*$",
			"afterText": "</([_:\\w][_:\\w-.\\d]*)\\s*>",
			"action": {
				"indent": "indentOutdent"
			}
		},
		{
			"beforeText": "<(?!(?:area|base|br|col|command|embed|hr|img|input|keygen|link|menuitem|meta|param|source|track|wbr))(\\w[\\w\\d]*)([^/>]*(?!/)>)[^<]*$",
			"action": {
				"indent": "indent"
			}
		}
	]
}