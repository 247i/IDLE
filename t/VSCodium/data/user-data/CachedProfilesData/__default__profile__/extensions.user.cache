ound color of struct field tag strings."},"rainbow-struct-field-tags.text-color":{"type":"string","default":"","description":"Basic text color of struct field tag strings."},"rainbow-struct-field-tags.gorm-tag-key":{"type":"string","default":"gorm","description":"Key to be recognized as gorm tags."},"rainbow-struct-field-tags.debounce-timeout":{"type":"integer","default":50,"description":"The debounce timeout milliseconds of redecorate on input, greater for less device requirements and less for less delay."}}},"grammars":[{"scopeName":"tag.struct.go","path":"./syntaxes/embed.tmLanguage.json","injectTo":["source.go","source.goctl"]}]},"scripts":{"vscode:prepublish":"npm run compile","compile":"tsc -p ./","watch":"tsc -watch -p ./","pretest":"npm run compile && npm run lint","lint":"eslint src","test":"vscode-test","build":"vsce package --no-dependencies","publish":"vsce publish --no-dependencies"},"devDependencies":{"@types/mocha":"^10.0.9","@types/node":"20.x","@types/vscode":"^1.85.2","@typescript-eslint/eslint-plugin":"^8.10.0","@typescript-eslint/parser":"^8.7.0","@vscode/test-cli":"^0.0.10","@vscode/test-electron":"^2.4.1","@vscode/vsce":"^3.2.1","eslint":"^9.13.0","typescript":"^5.6.3"}},"location":{"$mid":1,"path":"/D:/All/IDLE/t/VSCodium/data/extensions/se-dev-pion.rainbow-struct-field-tags-0.4.0-universal","scheme":"file"},"isBuiltin":false,"targetPlatform":"universal","publisherDisplayName":"se-dev-pion","metadata":{"installedTimestamp":1787044179822,"pinned":false,"source":"gallery","id":"1a23e0d5-8903-4c45-96dc-78a6dd9a3e10","publisherId":"30c33493-1e6c-49ac-b766-183b33322aa5","publisherDisplayName":"se-dev-pion","targetPlatform":"universal","updated":false,"private":false,"isPreReleaseVersion":false,"hasPreReleaseVersion":false,"size":81745},"isValid":true,"validations":[],"preRelease":false,"forceAutoUpdate":false},{"type":1,"identifier":{"id":"recca0120.vscode-phpunit","uuid":"ad577a34-d89a-4413-a066-12c941f6cef5"},"manifest":{"name":"vscode-phpunit","description":"Run PHPUnit and Pest tests in VS Code with the native Test Explorer. Supports Docker, SSH, Laravel Sail, ParaTest, and Xdebug step-debugging.","displayName":"PHPUnit & Pest Test Explorer","icon":"img/icon.png","publisher":"recca0120","version":"3.9.40","private":true,"license":"MIT","repository":{"type":"git","url":"https://github.com/recca0120/vscode-phpunit"},"engines":{"vscode":"^1.88.0"},"categories":["Testing","Other","Debuggers"],"keywords":["php","phpunit","pest","test"],"activationEvents":["workspaceContains:**/*.php"],"contributes":{"languages":[{"id":"phpunit","aliases":["PHPUnit","phpunit"],"configuration":"./language-configuration.json"}],"commands":[{"command":"phpunit.reload","title":"PHPUnit: Reload tests"},{"command":"phpunit.run-all","title":"PHPUnit: Run all tests"},{"command":"phpunit.run-file","title":"PHPUnit: Run tests in current file"},{"command":"phpunit.run-test-at-cursor","title":"PHPUnit: Run the test at the current cursor position"},{"command":"phpunit.run-by-group","title":"PHPUnit: Run tests by group"},{"command":"phpunit.rerun","title":"PHPUnit: Repeat the last test run"}],"keybindings":[{"key":"cmd+t cmd+s","command":"phpunit.run-all"},{"key":"cmd+t cmd+f","command":"phpunit.run-file","when":"editorTextFocus && editorLangId == php"},{"key":"cmd+t cmd+t","command":"phpunit.run-test-at-cursor","when":"editorTextFocus && editorLangId == php"},{"key":"cmd+t cmd+l","command":"phpunit.rerun","when":"editorTextFocus && editorLangId == php"}],"configuration":{"type":"object","title":"PHPUnit Configuration","properties":{"phpunit.php":{"type":"string","description":"Absolute path to php. Fallback to global php if it exists on the command line.","default":"php","scope":"resource"},"phpunit.phpunit":{"type":"string","description":"Path to phpunit. Can be the phpunit file or phpunit.phar.\n\nAutomatically finds it in common places:\n  - Composer vendor directory\n  - phpunit.phar in your project\n\nNote: This path is passed to the PHP binary (e.g. `php vendor/bin/phpunit`). For a globally installed phpunit, use `phpunit.command` instead.","default":"vendor/bin/phpunit","scope":"resource"},"phpunit.command":{"markdownDescription":"Custom command to for running and debugging tests. Use variables `${phpunit}`, `${phpunitxml}`, `${phpunitargs}`, `${php}`, `${phpargs}`, `${cwd}`.\n\nExample:\n\n`ddev exec phpunit -c ${phpunitxml} ${phpunitargs}`","type":"string","default":"\"${php}\" ${phpargs} \"${phpunit}\" ${phpunitargs}","scope":"resource","examples":["\"${php}\" ${phpargs} \"${phpunit}\" ${phpunitargs}","Custom command to run. Ex: `docker exec -t [container_id] /bin/sh -c \"${php}\" ${phpargs} \"${phpunit}\" ${phpunitargs}"]},"phpunit.saveBeforeTest":{"type":"boolean","default":false,"description":"Save all open files before running tests.","scope":"resource"},"phpunit.args":{"type":"array","default":[],"description":"Any phpunit args (phpunit --help) E.g. --configuration ${workspaceFolder}/phpunit.xml.dist","scope":"resource"},"phpunit.paths":{"type":"object","description":"Path mappings for your virtual/remote environments. Ex: { \"local/workspace/folder\": \"docker/workspace/folder\" }","scope":"resource"},"phpunit.environment":{"type":"object","title":"Set environment variables before running the phpunit command","scope":"resource"},"phpunit.output.preset":{"type":"string","enum":["progress","collision","pretty"],"default":"collision","description":"Output format preset. 'collision' shows detailed per-test results; 'progress' shows dot-progress; 'pretty' shows per-test without icons.","scope":"resource"},"phpunit.output.format":{"type":"object","default":{},"description":"Override individual format fields from the preset. See documentation for available fields.","scope":"resource"},"phpunit.clearDebugOutputOnRun":{"type":"boolean","default":true,"description":"Clear the debug output channel before each test run.","scope":"resource"},"phpunit.debuggerConfig":{"type":"string","default":null,