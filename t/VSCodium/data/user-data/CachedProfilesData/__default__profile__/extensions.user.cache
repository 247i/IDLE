ication","description":"Show the Bookmarks section in the Tools view."},"csharp-dev-tools.tools.showTodos":{"type":"boolean","default":true,"scope":"application","description":"Show the TODOs section in the Tools view when indexed comments are available."},"csharp-dev-tools.tools.showDiagrams":{"type":"boolean","default":true,"scope":"application","description":"Show the Diagrams section in the Tools view."},"csharp-dev-tools.tools.showNotebooks":{"type":"boolean","default":true,"scope":"application","description":"Show the Notebooks section in the Tools view."},"csharp-dev-tools.tools.showSecurity":{"type":"boolean","default":true,"scope":"application","description":"Show the Security section in the Tools view."},"csharp-dev-tools.tools.showFormatter":{"type":"boolean","default":true,"scope":"application","description":"Show the Formatter section in the Tools view."},"csharp-dev-tools.tools.showText":{"type":"boolean","default":true,"scope":"application","description":"Show the Text section in the Tools view."},"csharp-dev-tools.tools.showEncoders":{"type":"boolean","default":true,"scope":"application","description":"Show the Encoders / Decoders section in the Tools view."},"csharp-dev-tools.tools.showGenerators":{"type":"boolean","default":true,"scope":"application","description":"Show the Generators section in the Tools view."},"csharp-dev-tools.tools.showUserInterface":{"type":"boolean","default":true,"scope":"application","description":"Show the User Interface section in the Tools view."},"csharp-dev-tools.tools.sectionOrder":{"type":"array","items":{"type":"string"},"default":["nuget","runners","database","azure","bookmarks","todos","diagrams","notebooks","security","formatter","text","encoders","generators","ui-design"],"scope":"application","description":"Order of sections in the Tools view."}}},{"title":"Code Cleanup","properties":{"csharp-dev-tools.cleanup.buttonPlacement":{"type":"string","enum":["titleEditor","statusBar","titleEditorAndStatusBar","hidden"],"enumDescriptions":["Show the cleanup button in the editor title.","Show the cleanup button in the status bar.","Show the cleanup button in both the editor title and the status bar.","Hide the cleanup button."],"default":"titleEditor","scope":"application","description":"Choose where to show the Code Cleanup button."},"csharp-dev-tools.cleanup.statusBarPosition":{"type":"string","enum":["left","right"],"enumDescriptions":["Show the cleanup button on the left side of the status bar.","Show the cleanup button on the right side of the status bar."],"default":"left","scope":"application","description":"Choose the status bar position for the Code Cleanup button."},"csharp-dev-tools.cleanup.onFileOpen":{"type":"boolean","default":false,"scope":"application","description":"Run the active cleanup profile when a C# file is opened and it contains matching diagnostics."},"csharp-dev-tools.cleanup.onFileSave":{"type":"boolean","default":false,"scope":"application","description":"Run the active cleanup profile when a C# file is saved and it contains matching diagnostics."}}},{"title":"Solution Explorer","properties":{"csharp-dev-tools.solutionViewer.revealOnLoad":{"type":"boolean","default":true,"scope":"application","description":"Automatically reveal Solution Explorer when a solution is loaded"},"csharp-dev-tools.solutionViewer.expandCsFilesOutline":{"type":"boolean","default":true,"scope":"application","description":"Enable expanding .cs files to show their outline (classes, methods, properties, etc.)"},"csharp-dev-tools.solutionViewer.trackActiveFile":{"type":"boolean","default":true,"scope":"application","description":"Automatically reveal and select the active file in the Solution Explorer"},"csharp-dev-tools.solutionViewer.collapseOtherPaths":{"type":"boolean","default":false,"scope":"application","description":"When tracking active file, collapse all other expanded paths in the Solution Explorer"},"csharp-dev-tools.solutionViewer.autoNamespaceAdjustment":{"type":"boolean","default":true,"scope":"application","description":"Automatically adjust namespaces when moving C# files via drag and drop or cut/paste. When disabled, requires user confirmation for namespace adjustments."},"csharp-dev-tools.solutionViewer.requireConfirmationOnDragDrop":{"type":"boolean","default":false,"scope":"application","description":"Require confirmation when moving files via drag and drop. When disabled, files are moved without asking for confirmation."},"csharp-dev-tools.fileManagement.alwaysRenameType":{"type":"boolean","default":false,"scope":"application","description":"When renaming a C# file, automatically rename the matching type (class, interface, etc.) without asking for confirmation. When disabled, shows a confirmation dialog."},"csharp-dev-tools.solutionExplorer.fileManagement.recreateSolutionPathForNewSolutionFiles":{"type":"boolean","default":false,"scope":"application","description":"When adding solution files to a solution folder, recreate the solution folder structure in the file system. When true, files are placed in corresponding folders (e.g., /src solution folder creates a 'src' directory in the solution root). When false, files are added to the solution root directory."},"csharp-dev-tools.solutionViewer.highlightStartupProject":{"type":"boolean","default":true,"scope":"application","description":"Show a visual indicator (green 'S' badge) next to the startup project in Solution Explorer."},"csharp-dev-tools.solutionViewer.boldenStartupProject":{"type":"boolean","default":true,"scope":"application","description":"Display the startup project name in bold font using Unicode bold characters."},"csharp-dev-tools.solutionViewer.useCSharpDevToolsIconPack":{"type":"boolean","default":true,"scope":"application","description":"Use C# Dev Tools icon pack for files in Solution Explorer. When disabled, uses your currently selected icon theme for files (but keeps special icons for projects, folders, and solution items)."},"csharp-dev-tools.solutionViewer.selectedWorkspaceSolutions":{"type":"array","scope":"window","items":{"type":"string"},"description":"Solution files to load in C# Dev Tools for this workspace. Use the Change Workspace Solutions command to update this selection."},"csharp-dev-tools.solutionViewer.folderIconVariant":{"type":"string","enum":["Tabler","VS Code","Hero Icons","Hero Icons Solid","Phosphor","User theme"],"enumDescriptions":["Tabler outline folder style","VS Code outline folder style","Hero Icons outline folder style","Hero Icons solid folder style","Phosphor outline folder style","Use folder icons from the active VS Code file icon theme"],"default":"Tabler","description":"Choose the icon variant for folders in Solution Explorer. Select from various icon styles."},"csharp-dev-tools.solutionViewer.folderColorTheme":{"type":"string","enum":["default","blue","green","purple","orange","red","custom"],"enumDescriptions":["Default white/light gray folders","Blue colored folders","Green colored folders","Purple colored folders","Orange colored folders","Red colored folders","Custom color (choose your own color)"],"default":"default","description":"Choose the color theme for folder icons in Solution Explorer. Select from various color options or choose 'custom' to pick your own color."},"csharp-dev-tools.solutionViewer.customFolderColor":{"type":"string","default":"#3B82F6","description":"Custom color for folder icons when 'custom' theme is selected. Use hex color format (e.g., #3B82F6)."},"csharp-dev-tools.solutionViewer.folderThickness":{"type":"string","enum":["small","normal","medium","large"],"enumDescriptions":["Small folder stroke thickness (1px)","Normal folder stroke thickness (1.5px)","Medium folder stroke thickness (2px)","Large folder stroke thickness (3px)"],"default":"small","description":"Choose the stroke thickness for folder icons in Solution Explorer. Thicker strokes make folders more prominent and easier to see."},"csharp-dev-tools.solutionViewer.differentiateFolderOpenState":{"type":"boolean","default":true,"description":"Show different icons for opened and closed folders in Solution Explorer."}}},{"title":"Editor","properties":{"csharp-dev-tools.editor.highlightUnusedSymbols":{"type":"boolean","default":true,"scope":"application","description":"Highlight unused properties and methods by greying them out"},"csharp-dev-tools.editor.unusedSymbolStyle":{"type":"string","default":"dimmed","enum":["dimmed","underline"],"enumDescriptions":["Fade unused symbols with reduced opacity","Mark unused symbols with a yellow squiggly underline"],"scope":"application","description":"How unused symbols are visually highlighted when 'Highlight Unused Symbols' is enabled"},"csharp-dev-tools.editor.unusedSymbolOpacity":{"type":"number","default":0.5,"minimum":0.1,"maximum":1,"scope":"application","description":"Opacity level for unused symbols (0.1 = very faded, 1.0 = normal)"},"csharp-dev-tools.editor.autoImportNamespace":{"type":"boolean","default":true,"scope":"application","description":"Automatically execute 'add namespace' quick fixes when there is only one available option"},"csharp-dev-tools.editor.organizeUsingsOnSave":{"type":"boolean","default":false,"scope":"language-overridable","description":"Automatically sort and remove unused using directives when saving a C# file (requires Roslyn language server)"},"csharp-dev-tools.editor.removeUnusedUsingsOnSave":{"type":"boolean","default":false,"scope":"language-overridable","description":"Automatically remove unused using directives when saving a C# file. Use 'organizeUsingsOnSave' to also sort them (requires Roslyn language server)"}}},{"title":"Code Lens","properties":{"csharp-dev-tools.codeLens.enableTestGeneration":{"type":"boolean","default":true,"scope":"application","description":"Show 'Create Tests' code lens on public methods and classes in C# files"},"csharp-dev-tools.codeLens.enableTestRunner":{"type":"boolean","default":true,"scope":"application","description":"Show 'Run' and 'Debug' code lens on test methods and classes in C# test files"},"csharp-dev-tools.codeLens.enableGoToImplementation":{"type":"boolean","default":true,"scope":"application","description":"Show 'Go to Implementation' code lens on interface methods"},"csharp-dev-tools.codeLens.enableEnumAssignments":{"type":"boolean","default":true,"scope":"application","description":"Show 'Assignments' code lens on enum values to find where they are assigned"},"csharp-dev-tools.codeLens.enableReferences":{"type":"boolean","default":true,"scope":"application","description":"Show 'X references' code lens on types and members"},"csharp-dev-tools.codeLens.enableTypeInitializations":{"type":"boolean","default":true,"scope":"application","description":"Show 'X initializations' code lens on types to find where they are instantiated"},"csharp-dev-tools.codeLens.enableMemberAssignments":{"type":"boolean","default":true,"scope":"application","description":"Show 'X assignments' code lens on public properties and fields"}}},{"title":"Inlay Hints","properties":{"csharp-dev-tools.inlayHints.enableTypeHints":{"type":"boolean","default":true,"scope":"application","description":"Show inlay type hints for C# var declarations"},"csharp-dev-tools.inlayHints.enableParameterHints":{"type":"boolean","default":false,"scope":"application","description":"Show inlay parameter name hints for C# method calls"}}},{"title":"Debug","properties":{"csharp-dev-tools.debug.launchConsole":{"type":"string","enum":["integratedTerminal","internalConsole","externalTerminal"],"enumDescriptions":["Launch in VS Code's integrated terminal","Launch in VS Code's internal console (Debug Console)","Launch in an external terminal window"],"default":"integratedTerminal","scope":"application","description":"Controls where console applications are launched when debugging. Indicates which console the target program should be launched into. See https://aka.ms/VSCode-CS-LaunchJson-Console for more information."},"csharp-dev-tools.debug.programArguments":{"type":"string","default":"","scope":"resource","description":"Command line arguments to pass to the program when debugging or running. These arguments will be passed to the main method of programs."},"csharp-dev-tools.debug.skipBuild":{"type":"boolean","default":false,"scope":"resource","description":"Skip building the project before debugging. When enabled, the debugger will launch the last built version of the project without rebuilding."},"csharp-dev-tools.debug.enableWatch":{"type":"boolean","default":false,"scope":"application","description":"Enable 'dotnet watch' during debugging. When enabled, uses 'dotnet watch run' to support live code changes. When disabled, uses standard 'dotnet run'."},"csharp-dev-tools.debug.openOutputOnBuild":{"type":"boolean","default":false,"scope":"application","description":"Automatically open the 'C# Dev Tools' output channel when building projects. When enabled, the output panel opens automatically to show build logs."},"csharp-dev-tools.debug.runBuildInTerminal":{"type":"boolean","default":false,"scope":"application","description":"Run build commands in a VS Code terminal instead of the output channel. When enabled with 'Open Output on Build', the terminal will be focused automatically."},"csharp-dev-tools.debug.offerToRunLastBuild":{"type":"boolean","default":true,"scope":"application","description":"When a build fails, offer to run the last successful build if previous build artifacts exist. Shows a modal dialog with the age of the last build."},"csharp-dev-tools.debug.colorizeStatusBarButtons":{"type":"boolean","default":true,"scope":"application","description":"Apply custom colors to the Run and Debug buttons in the status bar. When enabled, the Run button is shown in green and the Debug button in red for better visual distinction."},"csharp-dev-tools.debug.showJumpToLineLens":{"type":"boolean","default":true,"scope":"application","description":"Show a 'Jump to Line' indicator on the current cursor line during debugging. Clicking it executes 'Set Next Statement' to move the execution point to that line."},"csharp-dev-tools.debug.jumpToLineIndicator":{"type":"string","enum":["codeLens","inlineHint"],"enumDescriptions":["Show as a CodeLens above the line","Show as grayed-out text at the end of the line"],"default":"inlineHint","scope":"application","description":"Controls how the 'Jump to Line' indicator is displayed during debugging."},"csharp-dev-tools.debug.jumpToLineHintPosition":{"type":"string","enum":["lineEnd","lineStart"],"enumDescriptions":["Show the hint at the end of the line","Show the hint at the start of the line"],"default":"lineEnd","scope":"application","description":"Controls the position of the inline hint when using 'Inline Hint' indicator style."}}},{"title":"Build","properties":{"csharp-dev-tools.build.configuration":{"type":"string","default":"Debug","scope":"resource","description":"Build configuration used when running, debugging, testing, or collecting coverage. Choose a project-defined configuration from the status bar."},"csharp-dev-tools.build.targetFramework":{"type":"string","default":"","scope":"resource","description":"Target framework used when running or debugging multi-targeted projects. Choose a project-defined target framework from the status bar."}}},{"title":"Testing","properties":{"csharp-dev-tools.testing.groupBy":{"type":"string","enum":["project-class","project-namespace-class","traits"],"enumDescriptions":["Group tests by Project > Class","Group tests by Project > Namespace > Class (default)","Group tests by Traits/Categories"],"default":"project-namespace-class","scope":"application","description":"How to organize and group tests in Test Explorer. Change requires refreshing tests."}}},{"title":"Inline Debug Values","properties":{"csharp-dev-tools.inlineDebugValues.enabled":{"type":"boolean","default":true,"scope":"application","description":"Show variable values inline in the editor during debugging sessions. Values are displayed at the end of lines where variables are declared or used. Changed values are highlighted in a different color."},"csharp-dev-tools.inlineDebugValues.showArrayValues":{"type":"boolean","default":true,"scope":"application","description":"Show actual values for arrays and lists (e.g., [1, 2, 3]) instead of just the count (e.g., List<int> [3 items]). When disabled, only the type and count will be shown for better performance with large collections."},"csharp-dev-tools.inlineDebugValues.maxArrayItems":{"type":"number","default":10,"minimum":1,"maximum":50,"scope":"application","description":"Maximum number of items to show when displaying array/list values inline. If the collection has more items, only the first N items will be shown with '...X more' indicator."},"csharp-dev-tools.inlineDebugValues.showObjectProperties":{"type":"boolean","default":true,"scope":"application","description":"Show object properties inline as JSON-like format (e.g., { name: \"John\", age: 30 }) instead of just the type name. When disabled, only the type will be shown for better performance with complex objects."},"csharp-dev-tools.inlineDebugValues.maxObjectProperties":{"type":"number","default":5,"minimum":1,"maximum":20,"scope":"application","description":"Maximum number of object properties to show when displaying object values inline. If the object has more properties, only the first N properties will be shown with '...X more' indicator."},"csharp-dev-tools.inlineDebugValues.maxNestedDepth":{"type":"number","default":2,"minimum":1,"maximum":5,"scope":"application","description":"Maximum depth level for expanding nested objects. Level 1 shows only direct properties, level 2 shows properties of properties, etc. Higher values may impact performance with deeply nested objects."},"csharp-dev-tools.inlineDebugValues.highlightChangedValues":{"type":"boolean","default":false,"scope":"application","description":"Highlight changed variable values in a different color (red). When disabled, all debug values will use the same color regardless of whether they have changed."}}},{"title":"Highlights","properties":{"csharp-dev-tools.highlights.xmlComments":{"type":"boolean","default":true,"scope":"application","description":"Enable syntax highlighting for XML documentation comments (tags, attributes, and values)"},"csharp-dev-tools.highlights.controllerTemplates":{"type":"boolean","default":true,"scope":"application","description":"Enable syntax highlighting for controller route templates (route parameters like {id} and tokens like [controller])"},"csharp-dev-tools.highlights.stringTemplates":{"type":"string","enum":["off","single-color","multi-color"],"enumDescriptions":["Disable logger template highlighting","Highlight only template variables like {Name} with a single color (Rider-style)","Highlight template variables and arguments with multiple colors"],"default":"multi-color","scope":"application","description":"Controls highlighting for logger string templates (e.g., LogInformation)"},"csharp-dev-tools.highlights.sqlHighlighting":{"type":"boolean","default":true,"scope":"application","description":"Enable syntax highlighting for raw SQL queries in C# string literals (SQL keywords and parameters like {0})"},"csharp-dev-tools.highlights.todoComments":{"type":"boolean","default":true,"scope":"application","description":"Enable C# TODO comment highlighting added by C# Dev Tools"}}},{"title":"Templates","properties":{"csharp-dev-tools.templates.useFileScopedNamespaces":{"type":"boolean","default":true,"scope":"application","description":"Use file-scoped namespaces in templates for .NET 6+ projects. When enabled, templates will use file-scoped namespace syntax (namespace MyNamespace;) instead of traditional block namespaces for .NET 6+ projects. For older .NET versions, traditional namespaces will be used regardless of this setting."},"csharp-dev-tools.templates.globalUsingsFileName":{"type":"string","default":"GlobalUsings.cs","scope":"resource","description":"Preferred filename for Global Using files. This file will be created when you use the 'Add > Global usings' command or when moving using statements from other files."}}},{"title":"Quick Add","properties":{"csharp-dev-tools.quickAdd.jsonToCsharp.usePascalCase":{"type":"boolean","default":true,"scope":"application","description":"Convert property names to PascalCase when generating C# classes from JSON."},"csharp-dev-tools.quickAdd.jsonToCsharp.useFields":{"type":"boolean","default":false,"scope":"application","description":"Generate fields instead of properties when creating C# classes from JSON."},"csharp-dev-tools.quickAdd.jsonToCsharp.useNullableTypes":{"type":"boolean","default":true,"scope":"application","description":"Use nullable reference types (?) for properties in generated C# classes."},"csharp-dev-tools.quickAdd.jsonToCsharp.addJsonPropertyAttributes":{"type":"boolean","default":true,"scope":"application","description":"Add JsonProperty attributes from Newtonsoft.Json to generated properties."},"csharp-dev-tools.quickAdd.jsonToCsharp.nullValueHandlingIgnore":{"type":"boolean","default":false,"scope":"application","description":"Add NullValueHandling.Ignore to JsonProperty attributes when using nullable types."},"csharp-dev-tools.quickAdd.jsonToCsharp.useJsonPropertyName":{"type":"boolean","default":false,"scope":"application","description":"Use JsonPropertyName attributes from System.Text.Json instead of Newtonsoft.Json."},"csharp-dev-tools.quickAdd.jsonToCsharp.generateImmutableClasses":{"type":"boolean","default":false,"scope":"application","description":"Generate immutable classes with get-only properties."},"csharp-dev-tools.quickAdd.jsonToCsharp.useRecordTypes":{"type":"boolean","default":false,"scope":"application","description":"Generate C# record types instead of classes."},"csharp-dev-tools.quickAdd.jsonToCsharp.useReadOnlyLists":{"type":"boolean","default":false,"scope":"application","description":"Use IReadOnlyList<T> instead of List<T> for array properties."},"csharp-dev-tools.quickAdd.jsonToCsharp.generateSeparateFiles":{"type":"boolean","default":true,"scope":"application","description":"Generate separate .cs files for each class when converting complex JSON objects."}}},{"title":"Semantic Colors","properties":{"csharp-dev-tools.semanticColors.mode":{"type":"string","enum":["global","workspace","off"],"enumDescriptions":["Apply semantic colors globally (user settings)","Apply semantic colors only to current workspace","Disable semantic colors"],"default":"global","scope":"application","description":"Controls where C# semantic token colors are applied. Global applies to all workspaces, workspace applies only to current workspace, off disables the feature."},"csharp-dev-tools.semanticColors.interfaceColor":{"type":"string","default":"","scope":"application","description":"Custom color for C# interface tokens. Leave empty to use theme-aware defaults (dark: #b8ce82, light: #2e7d32)."},"csharp-dev-tools.semanticColors.enumColor":{"type":"string","default":"","scope":"application","description":"Custom color for C# enum tokens. Leave empty to use theme-aware defaults (dark: #b8ce82, light: #7b1fa2)."},"csharp-dev-tools.semanticColors.namespaceColor":{"type":"string","default":"","scope":"application","description":"Custom color for C# namespace tokens. Leave empty to use theme-aware defaults (dark: #cccccc, light: #616161)."},"csharp-dev-tools.semanticColors.structColor":{"type":"string","default":"","scope":"application","description":"Custom color for C# struct tokens. Leave empty to use theme-aware defaults (dark: #86C691, light: #0277bd)."},"csharp-dev-tools.semanticColors.inactiveColor":{"type":"string","default":"","scope":"application","description":"Custom color for C# code excluded by an inactive preprocessor branch. Leave empty to use a theme-aware gray."}}},{"title":"Entity Framework","properties":{"csharp-dev-tools.entityFramework.migrationPreferences":{"type":"object","default":{},"scope":"resource","description":"Stores Entity Framework preferences for each solution"}}},{"title":"Pull Request Manager","properties":{"csharp-dev-tools.pullRequestManager.autoRefresh":{"type":"boolean","default":true,"scope":"application","description":"Automatically refresh pull requests when the view becomes visible"},"csharp-dev-tools.pullRequestManager.defaultProvider":{"type":"string","enum":["github","azuredevops"],"enumDescriptions":["GitHub pull requests","Azure DevOps pull requests"],"default":"github","scope":"application","description":"Default provider for creating pull requests"},"csharp-dev-tools.pullRequestManager.maxPullRequestsPerProvider":{"type":"number","default":50,"minimum":10,"maximum":200,"scope":"application","description":"Maximum number of pull requests to fetch per provider"},"csharp-dev-tools.pullRequestManager.showDrafts":{"type":"boolean","default":true,"scope":"application","description":"Show draft pull requests in the list"},"csharp-dev-tools.pullRequestManager.groupByStatus":{"type":"boolean","default":true,"scope":"application","description":"Group pull requests by status (open, closed, merged)"}}},{"title":"NuGet","properties":{"csharp-dev-tools.nuget.persistNuGetCredentials":{"type":"boolean","default":false,"scope":"application","description":"When enabled, NuGet credentials injected into nuget.config files will persist after dotnet operations complete. By default (false), credentials are automatically removed after operations complete for security. Enable this setting if you want credentials to remain in the configuration files permanently."},"csharp-dev-tools.nuget.showVersionDecorators":{"type":"boolean","default":true,"scope":"application","description":"Show version status indicators (✅/🆕) next to PackageReference elements in .csproj files. ✅ indicates the package is up to date, 🆕 indicates a newer version is available."},"csharp-dev-tools.nuget.enableCodeActions":{"type":"boolean","default":true,"scope":"application","description":"Enable code actions (quick fixes) for updating package versions in .csproj files. When the cursor is on a PackageReference line, shows all available versions with markers for (latest) and (current)."},"csharp-dev-tools.nuget.enableCompletions":{"type":"boolean","default":true,"scope":"application","description":"Enable IntelliSense completions for NuGet package names and versions in .csproj files. Provides autocomplete suggestions when typing <PackageReference Include=\" or Version=\"."}}},{"title":"Project Creation","properties":{"csharp-dev-tools.projectCreation.defaultParentFolderPath":{"type":"string","default":"","scope":"global","description":"Default parent folder path for new projects. Leave empty to use the last used folder path."},"csharp-dev-tools.projectCreation.onCreateBehaviour":{"type":"string","enum":["openInCurrentWindow","openInNewWindow","promptSelection"],"enumDescriptions":["Open the new project in the current window","Open the new project in a new window","Prompt to select how to open the new project"],"default":"openInNewWindow","scope":"global","description":"Determines how the new project should be opened after creation."},"csharp-dev-tools.projectCreation.recreateSolutionFolderPathInExplorer":{"type":"boolean","default":true,"scope":"global","description":"When enabled, creates physical directories matching solution folder hierarchy during project creation. When disabled, uses solution root directory for solution folders without physical counterparts."}}},{"title":"Test Generation","properties":{"csharp-dev-tools.testGeneration.defaultModel":{"type":"string","default":"","scope":"application","description":"Default language model to use for test generation. Leave empty to use the first available model. You can specify a model ID (e.g., 'copilot-gpt-4') or partial name."}}},{"title":"Playwright Testing","properties":{"csharp-dev-tools.playwright.showBrowser":{"type":"boolean","default":false,"scope":"application","description":"Show browser window when running Playwright tests. When enabled, tests run in headed mode (visible browser), when disabled tests run in headless mode (faster, no UI)."},"csharp-dev-tools.playwright.enableDebugger":{"type":"boolean","default":false,"scope":"application","description":"Enable Playwright debugger when running tests. When enabled, tests will pause at each step and open the Playwright inspector for debugging."},"csharp-dev-tools.playwright.slowMode":{"type":"boolean","default":false,"scope":"application","description":"Enable slow mode for Playwright tests. When enabled, adds a 500ms delay between actions to make test execution easier to follow visually."},"csharp-dev-tools.playwright.overrideRunSettings":{"type":"boolean","default":false,"scope":"application","description":"Override detected .runsettings files with custom Playwright settings. When enabled, uses the Playwright-specific settings instead of any detected .runsettings files."}}},{"title":"Excalidraw","properties":{"csharp-dev-tools.excalidraw.theme":{"description":"Excalidraw theme. Use auto to sync theme with VSCode color theme.","type":"string","default":"auto","enum":["auto","light","dark"],"enumDescriptions":["Automatically sync with VS Code theme","Always use light theme","Always use dark theme"]},"csharp-dev-tools.excalidraw.autoSave":{"description":"Automatically save diagram changes after drawing. When enabled, changes are saved after a short delay without requiring manual save.","type":"boolean","default":true,"scope":"application"},"csharp-dev-tools.excalidraw.autoSaveDelay":{"description":"Delay in milliseconds after the last change before auto-saving. Lower values save more frequently but may impact performance.","type":"number","default":2000,"minimum":500,"maximum":10000,"scope":"application"}}},{"title":"Roslyn Language Server","order":10,"properties":{"csharp-dev-tools.roslyn.workspaceProperties":{"type":"array","items":{"type":"string"},"default":[],"description":"Additional MSBuild properties to pass to the workspace (e.g. Configuration=Debug)."},"csharp-dev-tools.roslyn.showItemsFromUnimportedNamespaces":{"type":"boolean","default":true,"description":"Determines if items from unimported namespaces are shown in completion lists."},"csharp-dev-tools.roslyn.targetTypedCompletionFilter":{"type":"boolean","default":true,"description":"Determines if target-typed completion is enabled."},"csharp-dev-tools.roslyn.triggerCompletionOnSpace":{"type":"boolean","default":true,"description":"Trigger completion when a space is typed."},"csharp-dev-tools.roslyn.showCompletionTypeHints":{"type":"boolean","default":true,"description":"Show return/property types as inline hints in the autocomplete list. Disabling may improve completion performance in large projects."},"csharp-dev-tools.roslyn.addCompletionMethodParentheses":{"type":"boolean","default":true,"description":"Add parentheses to method completions and trigger signature help when needed."},"csharp-dev-tools.roslyn.skipUnrecognizedProjects":{"type":"boolean","default":true,"description":"Determines if unrecognized projects are skipped when projects are opened."},"csharp-dev-tools.roslyn.loadMetadataForReferencedProjects":{"type":"boolean","default":true,"description":"Determines if metadata from existing output assemblies is loaded instead of opening referenced projects. Significantly speeds up workspace loading for solutions that have been built."},"csharp-dev-tools.roslyn.restoreProjectsBeforeLoading":{"type":"boolean","default":true,"description":"Determines if projects are restored before they are loaded."},"csharp-dev-tools.roslyn.compileProjectsAfterLoading":{"type":"boolean","default":true,"description":"Determines if projects are compiled after they are loaded."},"csharp-dev-tools.roslyn.compilerDiagnosticsScope":{"type":"string","default":"Project","description":"Show compiler errors and warnings for:","enum":["None","Document","Project","Solution"],"enumDescriptions":["Disable compiler diagnostics","Show diagnostics for the current document only","Show diagnostics for the current project","Show diagnostics for the entire solution"]},"csharp-dev-tools.roslyn.analyzerDiagnosticsScope":{"type":"string","default":"Document","description":"Show analyzer errors and warnings for:","enum":["None","Document","Project","Solution"],"enumDescriptions":["Disable analyzer diagnostics","Show diagnostics for the current document only","Show diagnostics for the current project","Show diagnostics for the entire solution"]},"csharp-dev-tools.roslyn.diagnosticsFormat":{"type":"string","default":"NoHints","description":"Determines how diagnostics are presented in the editor.","enum":["AsIs","NoHints","InfosAsHints"],"enumDescriptions":["Show diagnostics as-is without any hint transformation","Show diagnostics without hints (hides hint-level diagnostics)","Show informational diagnostics as hints in the editor"]},"csharp-dev-tools.roslyn.dispatcherType":{"type":"string","default":"MultiThread","description":"Determines the type of dispatcher used by the server.","enum":["SingleThread","MultiThread","PerformanceCounter"],"enumDescriptions":["Use a single-threaded dispatcher","Use a multi-threaded dispatcher for better performance","Use a performance counter dispatcher"]},"csharp-dev-tools.roslyn.dotnetSdkDirectory":{"type":"string","description":"Path to the SDK directory to use for .NET projects."},"csharp-dev-tools.roslyn.analyzerAssemblies":{"type":"array","scope":"machine","items":{"type":"string"},"description":"Paths to additional Roslyn analyzer assemblies (.dll files) to include during analysis."},"csharp-dev-tools.roslyn.roslynatorEnabled":{"type":"boolean","default":true,"description":"Enable or disable all Roslynator analyzers, code fixes, and refactorings."},"csharp-dev-tools.roslyn.roslynatorAnalyzersEnabled":{"type":"boolean","default":true,"description":"Enable or disable Roslynator diagnostic analyzers (~180 rules). Requires roslynatorEnabled."},"csharp-dev-tools.roslyn.roslynatorCodeFixesEnabled":{"type":"boolean","default":true,"description":"Enable or disable Roslynator code fixes (~195 providers). Requires roslynatorEnabled."},"csharp-dev-tools.roslyn.roslynatorRefactoringsEnabled":{"type":"boolean","default":true,"description":"Enable or disable Roslynator refactorings (~207 refactorings). Requires roslynatorEnabled."},"csharp-dev-tools.roslyn.roslynatorFormattingAnalyzersEnabled":{"type":"boolean","default":true,"description":"Enable or disable Roslynator formatting analyzers (~30 rules for blank lines, braces, indentation, etc.). Requires roslynatorEnabled."}}},{"title":"Debugger (CoreCLR / Unity)","order":11,"properties":{"csharp-dev-tools.debugger.projectAssembliesOnly":{"type":"boolean","default":true,"description":"Use only project assemblies for debugging."},"csharp-dev-tools.debugger.stepOverPropertiesAndOperators":{"type":"boolean","default":true,"description":"Step over properties and operators."},"csharp-dev-tools.debugger.searchMicrosoftSymbolServer":{"type":"boolean","default":false,"description":"Search Microsoft Symbol Server for missing PDBs."},"csharp-dev-tools.debugger.automaticSourcelinkDownload":{"type":"boolean","default":true,"description":"Automatically download source files from SourceLink."},"csharp-dev-tools.debugger.symbolSearchPaths":{"type":"array","description":"Additional symbol search paths.","items":{"type":"string"}},"csharp-dev-tools.debugger.console":{"type":"string","default":"internalConsole","description":"Console to use for debugging console applications.","enum":["internalConsole","integratedTerminal","externalTerminal"],"enumDescriptions":["Use VS Code's internal debug console","Use VS Code's integrated terminal","Use an external terminal window"]},"csharp-dev-tools.debugger.launchBrowser":{"type":"boolean","default":true,"description":"Automatically open a browser when debugging ASP.NET applications."}}},{"title":"MSBuild","order":12,"properties":{"csharp-dev-tools.msbuild.noRestore":{"type":"boolean","default":false,"description":"Determines if the project will be restored before building."},"csharp-dev-tools.msbuild.noDependencies":{"type":"boolean","default":false,"description":"Determines if the project dependencies will be built."},"csharp-dev-tools.msbuild.additionalBuildArguments":{"type":"array","description":"Additional arguments to pass to the build command.","items":{"type":"string"}}}}],"debuggers":[{"type":"devtools","label":"C# Dev Tools","runtime":"dotnet","languages":["csharp"],"configurationAttributes":{"launch":{"required":["projectPath"],"properties":{"projectPath":{"type":"string","description":"Path to the .csproj file (relative or absolute)","default":"${workspaceFolder}/src/MyProject/MyProject.csproj"},"projectType":{"type":"string","enum":["console","web","winforms","wpf","function","aspire","library","unknown"],"enumDescriptions":["Console application","Web application (ASP.NET Core)","Windows Forms application","WPF application","Azure Functions project","Aspire AppHost project","Class library","Unknown project type"],"description":"Type of the project (auto-detected if not specified)"},"withDebug":{"type":"boolean","default":true,"description":"Whether to run with debugging enabled"},"targetFramework":{"type":"string","description":"Target framework (e.g., net8.0) - auto-detected if not specified"},"launchProfile":{"type":"string","description":"Launch profile name from launchSettings.json"},"console":{"type":"string","enum":["integratedTerminal","internalConsole","externalTerminal"],"enumDescriptions":["VS Code's integrated terminal","VS Code's internal debug console","External terminal window"],"default":"integratedTerminal","description":"Console type for output"},"env":{"type":"object","additionalProperties":{"type":"string"},"description":"Environment variables to set for the process"},"args":{"type":"array","items":{"type":"string"},"description":"Command line arguments to pass to the program"},"cwd":{"type":"string","description":"Working directory for the project"},"url":{"type":"string","description":"URL for web projects (e.g., http://localhost:5000)"},"launchBrowser":{"type":"boolean","default":true,"description":"Whether to launch browser for web projects"},"setAsStartup":{"type":"boolean","default":false,"description":"Whether to set this project as the startup project"},"configuration":{"type":"string","enum":["Debug","Release"],"default":"Debug","description":"Build configuration"},"skipBuild":{"type":"boolean","default":false,"description":"Skip building before launch"},"enableHotReload":{"type":"boolean","default":false,"description":"Enable .NET Hot Reload using 'dotnet watch'. When enabled, allows live code changes during debugging."},"logging":{"type":"object","properties":{"moduleLoad":{"type":"boolean","default":false,"description":"Enable module load logging"}},"description":"Logging options"}}}},"initialConfigurations":[{"name":"C# Dev Tools: Launch","type":"devtools","request":"launch","projectPath":"${workspaceFolder}/src/MyProject/MyProject.csproj","withDebug":true}],"configurationSnippets":[{"label":"C# Dev Tools: Launch Project","description":"Launch a .NET project using C# Dev Tools","body":{"name":"Launch ${1:ProjectName}","type":"devtools","request":"launch","projectPath":"^\"\\${workspaceFolder}/${2:src/MyProject/MyProject.csproj}\"","withDebug":true}},{"label":"C# Dev Tools: Launch Web Project","description":"Launch an ASP.NET Core web project with browser opening","body":{"name":"Launch ${1:WebApp}","type":"devtools","request":"launch","projectPath":"^\"\\${workspaceFolder}/${2:src/WebApp/WebApp.csproj}\"","projectType":"web","withDebug":true,"launchBrowser":true,"url":"https://localhost:5001"}},{"label":"C# Dev Tools: Launch with Profile","description":"Launch using a specific launch profile from launchSettings.json","body":{"name":"Launch ${1:Project} (${2:Development})","type":"devtools","request":"launch","projectPath":"^\"\\${workspaceFolder}/${3:src/MyProject/MyProject.csproj}\"","launchProfile":"${2:Development}","withDebug":true}},{"label":"C# Dev Tools: Run Without Debugging","description":"Run a .NET project without the debugger attached","body":{"name":"Run ${1:ProjectName}","type":"devtools","request":"launch","projectPath":"^\"\\${workspaceFolder}/${2:src/MyProject/MyProject.csproj}\"","withDebug":false}}]},{"program":"extension/bin/Debugger/clrdbg","windows":{"program":"extension/bin/Debugger/clrdbg.exe"},"args":["--interpreter=vscode"],"type":"coreclr","label":".NET Core Debugger","languages":["csharp","fsharp","vb","razor","aspnetcorerazor","xml"],"configurationAttributes":{"launch":{"properties":{"program":{"type":"string"},"args":{"type":"array"},"cwd":{"type":"string"},"env":{"type":"object"},"console":{"type":"string","enum":["internalConsole","integratedTerminal","externalTerminal"]},"sourceFileMap":{"type":"object"},"justMyCode":{"type":"boolean"},"requireExactSource":{"type":"boolean"},"enableStepFiltering":{"type":"boolean"},"pipeTransport":{"type":"object"},"suppressJITOptimizations":{"type":"boolean"},"symbolOptions":{"type":"object"},"sourceLinkOptions":{"type":"object"},"launchSettingsFilePath":{"type":"string"},"launchSettingsProfile":{"type":"string"},"launchWebBrowser":{"type":"boolean"}}},"attach":{"properties":{"processId":{"type":"string"},"processPath":{"type":"string"},"sourceFileMap":{"type":"object"},"justMyCode":{"type":"boolean"},"requireExactSource":{"type":"boolean"},"enableStepFiltering":{"type":"boolean"},"symbolOptions":{"type":"object"},"sourceLinkOptions":{"type":"object"}}}}},{"program":"extension/bin/DebuggerMono/monodbg","windows":{"program":"extension/bin/DebuggerMono/monodbg.exe"},"type":"unity","label":"Unity Debugger","languages":["csharp","fsharp","vb"],"initialConfigurations":[{"name":"Unity Debugger","type":"unity","request":"attach"}],"configurationSnippets":[{"label":"Unity Debugger","description":"Attach Unity Debugger","body":{"name":"Unity Debugger","type":"unity","request":"attach"}}],"configurationAttributes":{"attach":{"properties":{"program":{"type":"string"},"processId":{"type":"number"},"transportArgs":{"type":"object"},"cwd":{"type":"string"},"env":{"type":"object"},"debuggerOptions":{"type":"object"},"userAssemblies":{"type":"array","items":{"type":"string"}}}}}}],"breakpoints":[{"language":"csharp"},{"language":"fsharp"},{"language":"vb"},{"language":"razor"},{"language":"aspnetcorerazor"}],"taskDefinitions":[{"type":"csharp-dev-tools.task","required":[],"properties":{"project":{"type":"string","default":"${command:csharp-dev-tools.activeProjectPath}"},"args":{"type":"array","default":[],"items":{"type":"string"}}}}],"customEditors":[{"viewType":"csharp-dev-tools.excalidraw","displayName":"Excalidraw","priority":"default","selector":[{"filenamePattern":"*.excalidraw"},{"filenamePattern":"*.excalidraw.json"}]},{"viewType":"csharp-dev-tools.speedscope","displayName":"Speedscope Viewer","priority":"default","selector":[{"filenamePattern":"*.speedscope.json"},{"filenamePattern":"speedscope*.json"}]}]},"scripts":{"vscode:prepublish":"npm run build-speedscope && npm run build-webviews && npm run package","compile":"webpack","compile:full":"cd webviews && npm run build && cd .. && webpack","watch":"webpack --watch","package":"webpack --mode production --devtool hidden-source-map","build-server":"dotnet publish ../csharp-dev-tools-lsp/server/CsharpDevTools.Roslyn.Server/CsharpDevTools.Roslyn.Server.csproj -c Release -p:AssetsPath=%cd%/extension/bin/ && dotnet publish ../csharp-dev-tools-lsp/server/CsharpDevTools.Debugging.Mono/CsharpDevTools.Debugging.Mono.csproj -c Release -p:AssetsPath=%cd%/extension/bin/","build-notebook-host":"dotnet publish ../csharp-dev-tools-lsp/host/CSharpNotebook.Host/CSharpNotebook.Host.csproj -c Debug -o host/CSharpNotebook.Host/bin/Debug/net8.0","build-webviews":"cd webviews && npm ci && npm run build","watch-webviews":"cd webviews && npm run dev","test-webviews":"cd webvie