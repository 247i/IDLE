https://github.com/Astrapios/vscode_python_repl.git"},"main":"./out/extension.js","contributes":{"commands":[{"command":"pythonREPL.sendFileContents","title":"Python REPL: Send File Contents"},{"command":"pythonREPL.sendSelected","title":"Python REPL: Send Selected Text (or current line)"},{"command":"pythonREPL.activatePython","title":"Python REPL: Activate/Initialize Python"},{"command":"pythonREPL.sendCell","title":"Python REPL: Send Cell"},{"command":"pythonREPL.sendCellAndMove","title":"Python REPL: Send Cell and Move to Next Cell"},{"command":"pythonREPL.sendAllAbove","title":"Python REPL: Send Everything Above Current Cell"},{"command":"pythonREPL.goToNextCell","title":"Python REPL: Go to Next Cell"},{"command":"pythonREPL.goToPreviousCell","title":"Python REPL: Go to Previous Cell"},{"command":"pythonREPL.goToCellStart","title":"Python REPL: Go to Cell Start"},{"command":"pythonREPL.goToCellEnd","title":"Python REPL: Go to Cell End"}],"configuration":{"type":"object","title":"Python REPL","properties":{"pythonREPL.runInCurrentDirectory":{"type":"boolean","default":true,"description":"Enable/Disable Run in the same directory as the file"},"pythonREPL.sendTextDirectly":{"type":"boolean","default":false,"description":"Enable/Disable direct text send"},"pythonREPL.focusActiveEditorGroup":{"type":"boolean","default":true,"description":"Enable/Disable run focus Active EditorGroup."},"pythonREPL.customTerminalCommand":{"type":"string","description":"Custom commands to run when creating a new integrated terminal"},"pythonREPL.customEnvironmentActivationCommand":{"type":"string","description":"Custom environment activation command (if not set, will auto-detect conda/virtual environments from VS Code Python interpreter)"},"pythonREPL.pythonRunCommand":{"type":"string","default":"ipython --matplotlib","description":"Default Python REPL with options (full path accepted)"},"pythonREPL.terminalInitTimeout":{"type":"number","default":1000,"description":"Milliseconds to wait for terminal initialization"},"pythonREPL.pythonInitTimeout":{"type":"number","default":300,"description":"Milliseconds to wait for Python repl initialization"},"pythonREPL.isAutoInputLine":{"type":"boolean","default":false,"description":"Enable/Disable auto get line in doc. use`%load`"},"pythonREPL.cell.blockSymbol":{"type":"string","default":"#.*%%.*","description":"Cell block indicator"},"pythonREPL.cell.regexFlags":{"type":"string","default":"i","description":"Regex flags to use for cell block search"},"pythonREPL.cell.copyToClipboard":{"type":"boolean","default":false,"description":"Copy the sent cell to the clipboard"},"pythonREPL.cell.debugNotify":{"type":"boolean","default":false,"description":"Show a notify message of the used search properties"},"pythonREPL.saveFileBeforeSend":{"type":"boolean","default":true,"description":"Save the document before send"}}}},"scripts":{"vscode:prepublish":"npm run compile","compile":"tsc -p ./","watch":"tsc -watch -p ./","pretest":"npm run compile && npm run lint","lint":"eslint src --ext ts","test":"node ./out/test/runTest.js"},"devDependencies":{"@types/glob":"^8.1.0","@types/mocha":"^10.0.0","@types/node":"16.x","@types/vscode":"^1.75.0","@typescript-eslint/eslint-plugin":"^5.62.0","@typescript-eslint/parser":"^5.62.0","@vscode/test-electron":"^2.5.2","eslint":"^8.57.0","glob":"^13.0.0","mocha":"^10.8.2","typescript":"^4.9.5"}},"location":{"$mid":1,"path":"/D:/All/IDLE/t/VSCodium/data/extensions/astrapios.pythonrepl-0.5.2-universal","scheme":"file"},"isBuiltin":false,"targetPlatform":"universal","publisherDisplayName":"astrapios","metadata":{"installedTimestamp":1787670549118,"pinned":false,"source":"gallery","id":"0608a81a-6a0f-4f2f-b7e6-c40f9744e682","publisherId":"63c80bad-40e5-4560-a3e6-979d11c07112","publisherDisplayName":"astrapios","targetPlatform":"universal","updated":false,"private":false,"isPreReleaseVersion":false,"hasPreReleaseVersion":false,"size":43733},"isValid":true,"validations":[],"preRelease":false,"forceAutoUpdate":false},{"type":1,"identifier":{"id":"mgesbert.python-path","uuid":"963e502d-de59-484a-9db5-c1e02f00fc4c"},"manifest":{"activationEvents":["onLanguage:python","onCommand:extension.copyPythonPath","onCommand:extension.generateImportStatement"],"author":{"name":"Mathias Gesbert"},"categories":["Programming Languages","Snippets","Formatters","Other","Extension Packs"],"contributes":{"commands":[{"command":"extension.copyPythonPath","title":"Copy Python Path","when":"resourceLangId == python"}],"menus":{"editor/context":[{"command":"extension.copyPythonPath","group":"9_cutcopypaste@30000","title":"Copy Python Path","when":"resourceLangId == python"}],"editor/title/context":[{"command":"extension.copyPythonPath","group":"1_cutcopypaste@30000","title":"Copy Python Path","when":"resourceLangId == python"}],"explorer/context":[{"command":"extension.copyPythonPath","group":"5_cutcopypaste@30000","title":"Copy Python Path","when":"resourceLangId == python"}]}},"contributors":["Nicolas Faurie"],"description":"Python imports utils.","devDependencies":{"@types/mocha":"^2.2.42","@types/node":"^7.0.43","eslint":"^4.11.0","typescript":"^2.6.1","vscode":"^1.1.6"},"displayName":"Python Path","engines":{"vscode":"^1.22.0"},"galleryBanner":{"color":"#1e415e","theme":"dark"},"icon":"images/icon.png","keywords":["import","export","python","generator"],"main":"./extension","name":"python-path","publisher":"mgesbert","repository":{"type":"git","url":"https://github.com/mgesbert/vscode-python-path.git"},"scripts":{"postinstall":"node ./node_modules/vscode/bin/install","test":"node ./node_modules/vscode/bin/test"},"version":"0.0.14"},"location":{"$mid":1,"path":"/D:/All/IDLE/t/VSCodium/data/extensions/mgesbert.python-path-0.0.14-universal","scheme":"file"},"isBuiltin":false,"targetPlatform":"universal","publisherDisplayName":"mgesbert","metadata":{"installedTimestamp":1787670593218,"pinned":false,"source":"gallery","id":"963e502d-de59-484a-9db5-c1e02f00fc4c","publisherId":"29620074-3dd0-4baa-8334-25fecadc63cf","publisherDisplayName":"mgesbert","targetPlatform":"universal","updated":false,"private":false,"isPreReleaseVersion":false,"hasPreReleaseVersion":false,"size":407273},"isValid":true,"validations":[],"preRelease":false,"forceAutoUpdate":false},{"type":1,"identifier":{"id":"ms-python.pylint","uuid":"8dc47276-5882-4c5f-903d-7eef7b9d1584"},"manifest":{"name":"pylint","displayName":"Pylint","description":"Linting support for Python files using Pylint.","version":"2025.2.0","preview":true,"serverInfo":{"name":"Pylint","module":"pylint"},"publisher":"ms-python","license":"MIT","homepage":"https://github.com/Microsoft/vscode-pylint","repository":{"type":"git","url":"https://github.com/microsoft/vscode-pylint.git"},"bugs":{"url":"https://github.com/Microsoft/vscode-pylint/issues"},"icon":"icon.png","galleryBanner":{"color":"#1e415e","theme":"dark"},"keywords":["python","linting","pylint"],"engines":{"vscode":"^1.74.0"},"categories":["Programming Languages","Linters"],"extensionDependencies":["ms-python.python"],"capabilities":{"virtualWorkspaces":{"supported":false,"description":"Virtual Workspaces are not supported with pylint."}},"activationEvents":["onLanguage:python","workspaceContains:.pylintrc","workspaceContains:*.py"],"main":"./dist/extension.js","l10n":"./l10n","scripts":{"vscode:prepublish":"npm run package","compile":"webpack","watch":"webpack --watch","package":"webpack --mode production --devtool source-map --config ./webpack.config.js","compile-tests":"tsc -p . --outDir out","watch-tests":"tsc -p . -w --outDir out","pretest":"npm run compile-tests && npm run compile","lint":"eslint src --ext ts","format-check":"prettier --check 'src/**/*.ts' 'build/**/*.yml' '.github/**/*.yml'","tests":"node ./out/test/ts_tests/runTest.js","vsce-package":"vsce package -o pylint.vsix"},"contributes":{"languages":[{"filenames":[".pylintrc"],"id":"ini"}],"configuration":{"properties":{"pylint.args":{"default":[],"markdownDescription":"Arguments passed to Pylint for linting Python files. Each argument should be provided as a separate string in the array. \n Examples:  \n- `\"pylint.args\": [\"--rcfile=<file>\"]` \n - `\"pylint.args\": [\"--disable=C0111\", \"--max-line-length=120\"]`","items":{"type":"string"},"scope":"resource","type":"array"},"pylint.cwd":{"default":"${workspaceFolder}","markdownDescription":"Sets the current working directory used to lint Python files with Pylint. By default, it uses the root directory of the workspace `${workspaceFolder}`. You can set it to `${fileDirname}` to use the parent folder of the file being linted as the working directory for Pylint.","scope":"resource","type":"string","examples":["${workspaceFolder}/src","${fileDirname}"]},"pylint.enabled":{"default":true,"markdownDescription":"Enable/disable linting Python files with Pylint.","scope":"resource","type":"boolean"},"pylint.ignorePatterns":{"default":[],"markdownDescription":"Configure [glob patterns](https://docs.python.org/3/library/fnmatch.html) as supported by the fnmatch Python library to exclude files or folders from being linted with Pylint.","items":{"type":"string"},"scope":"resource","type":"array","uniqueItems":true,"examples":[["**/site-packages/**/*.py",".vscode/*.py"]]},"pylint.importStrategy":{"default":"useBundled","markdownDescription":"Defines which Pylint binary to be used to lint Python files. When set to `useBundled`, the extension will use the Pylint binary that is shipped with the extension. When set to `fromEnvironment`, the extension will attempt to use the Pylint binary and all dependencies that are available in the currently selected environment. Note: If the extension can't find a valid Pylint binary in the selected environment, it will fallback to using the Pylint binary that is shipped with the extension The `pylint.path` setting may also be ignored when this setting is set to `fromEnvironment`.","enum":["useBundled","fromEnvironment"],"enumDescriptions":["Always use the bundled version of Pylint shipped with the extension.","Use Pylint from the selected environment. If the extension fails to find a valid Pylint binary, it will fallback to using the bundled version of Pylint."],"scope":"resource","type":"string"},"pylint.interpreter":{"default":[],"markdownDescription":"Path to a Python executable or a command that will be used to launch the Pylint server and any subprocess. Accepts an array of a single or multiple strings.  When set to `[]`, the extension will use the path to the selected Python interpreter. If passing a command, each argument should be provided as a separate string in the array.","scope":"resource","items":{"type":"string"},"type":"array"},"pylint.lintOnChange":{"default":false,"markdownDescription":"Enable linting Python files with Pylint as you type.","scope":"machine","type":"boolean","tags":["experimental"]},"pylint.path":{"default":[],"markdownDescription":"Path or command to be used by the extension to lint Python files with Pylint. Accepts an array of a single or multiple strings. If passing a command, each argument should be provided as a separate string in the array. If set to `[\"pylint\"]`, it will use the version of Pylint available in the `PATH` environment variable. Note: Using this option may slowdown linting. \nExamples: \n- `[\"~/global_env/pylint\"]` \n- `[\"conda\", \"run\", \"-n\", \"lint_env\", \"python\", \"-m\", \"pylint\"]` \n `[\"pylint\"]`","scope":"resource","items":{"type":"string"},"type":"array","examples":[["~/global_env/pylint"],["~/.env/python","-m","pylint"]]},"pylint.severity":{"default":{"convention":"Information","error":"Error","fatal":"Error","refactor":"Hint","warning":"Warning","info":"Information"},"additionalProperties":{"type":"string","enum":["Error","Hint","Information","Warning"]},"markdownDescription":"Mapping of Pylint's message types to VS Code's diagnostic severity levels as displayed in the Problems window. You can also use it to override specific Pylint error codes. \n Example:</br> `{\"convention\": \"Information\", \"error\": \"Error\", \"fatal\": \"Error\", \"refactor\": \"Hint\", \"warning\": \"Warning\", \"W0611\": \"Error\", \"undefined-variable\": \"Warning\"}`","scope":"resource","type":"object"},"pylint.showNotifications":{"default":"off","markdownDescription":"Controls when notifications are shown by this extension.  Accepted values are `onError`, `onWarning`, `always` and `off`.","enum":["off","onError","onWarning","always"],"enumDescriptions":["Never display a notification. Any errors or warning are still available in the logs.","Show notifications for errors.","Show notifications for errors and warnings.","Show all notifications."],"scope":"machine","type":"string"}}},"commands":[{"title":"Restart Server","category":"Pylint","command":"pylint.restart"}]},"dependencies":{"@vscode/python-extension":"^1.0.5","fs-extra":"^11.2.0","vscode-languageclient":"^8.1.0"},"devDependencies":{"@types/chai":"^4.3.16","@types/fs-extra":"^11.0.4","@types/glob":"^8.1.0","@types/mocha":"^10.0.6","@types/node":"16.x","@types/sinon":"^17.0.3","@types/vscode":"^1.74.0","@typescript-eslint/eslint-plugin":"^7.13.0","@typescript-eslint/parser":"^7.13.0","@vscode/test-electron":"^2.4.0","@vscode/vsce":"^2.27.0","chai":"^4.3.10","eslint":"^8.57.0","glob":"^10.4.1","mocha":"^10.4.0","prettier":"^3.3.2","sinon":"^18.0.0","ts-loader":"^9.5.1","typemoq":"^2.1.0","typescript":"^5.4.5","webpack":"^5.92.0","webpack-cli":"^5.1.4"}},"location":{"$mid":1,"path":"/D:/All/IDLE/t/VSCodium/data/extensions/ms-python.pylint-2025.2.0-universal","scheme":"file"},"isBuiltin":false,"targetPlatform":"universal","publisherDisplayName":"ms-python","metadata":{"installedTimestamp":1787670944825,"pinned":false,"source":"gallery","id":"8dc47276-5882-4c5f-903d-7eef7b9d1584","publisherId":"998b010b-e2af-44a5-a6cd-0b5fd3b9b6f8","publisherDisplayName":"ms-python","targetPlatform":"universal","updated":false,"private":false,"isPreReleaseVersion":false,"hasPreReleaseVersion":fal