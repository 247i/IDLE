us","title":"Jump to Previous","category":"Bookmarks"},{"command":"_bookmarks.jumpTo","title":"Jump to Document/Line","category":"Bookmarks"},{"command":"bookmarks.selectLines","title":"Select Lines","category":"Bookmarks (Selection)"},{"command":"bookmarks.expandSelectionToNext","title":"Expand Selection to Next","category":"Bookmarks (Selection)"},{"command":"bookmarks.expandSelectionToPrevious","title":"Expand Selection to Previous","category":"Bookmarks (Selection)"},{"command":"bookmarks.shrinkSelection","title":"Shrink Selection","category":"Bookmarks (Selection)"},{"command":"bookmarks.list","title":"List","category":"Bookmarks"},{"command":"bookmarks.toggleLabeled","title":"Toggle Labeled","category":"Bookmarks"},{"command":"_bookmarks.addBookmark#sideBar","title":"Add Bookmark","icon":"$(add)"},{"command":"_bookmarks.search#sideBar","title":"Search","icon":"$(search)"},{"command":"bookmarks.refresh","title":"Refresh","icon":"$(refresh)"},{"command":"_bookmarks.viewAsTree#sideBar","title":"View as Tree","icon":"$(list-tree)","enablement":"bookmarks.viewAsList"},{"command":"_bookmarks.viewAsList#sideBar","title":"View as List","icon":"$(list-flat)","enablement":"!bookmarks.viewAsList"},{"command":"bookmarks.openSettings","title":"Open Settings"},{"command":"_bookmarks.sidebar.hidePosition","title":"Hide Position"},{"command":"_bookmarks.sidebar.showPosition","title":"Show Position"},{"command":"bookmarks.clear","title":"Clear","category":"Bookmarks"},{"command":"_bookmarks.clearFromFile","title":"Clear","icon":"$(clear-all)"},{"command":"_bookmarks.deleteBookmark","title":"Delete","icon":"$(close)"},{"command":"_bookmarks.editLabel","title":"Edit Label","icon":"$(edit)"},{"command":"_bookmarks.addBookmarkAtLine#gutter","title":"Add Bookmark"},{"command":"_bookmarks.addLabeledBookmarkAtLine#gutter","title":"Add Labeled Bookmark"},{"command":"_bookmarks.removeBookmarkAtLine#gutter","title":"Remove Bookmark"},{"command":"bookmarks.listFromAllFiles","title":"List from All Files","category":"Bookmarks"},{"command":"bookmarks.clearFromAllFiles","title":"Clear from All Files","category":"Bookmarks"},{"command":"_bookmarks.clearFromAllFiles#sideBar","title":"Clear from All Files","icon":"$(clear-all)"},{"command":"bookmarks.whatsNew","title":"What's New","category":"Bookmarks"},{"command":"_bookmarks.whatsNewContextMenu","title":"What's New"},{"command":"_bookmarks.openFolderWelcome","title":"Open Folder"},{"command":"bookmarks.supportBookmarks","title":"Support Bookmarks","category":"Bookmarks"},{"command":"_bookmarks.openSideBar","title":"Open Side Bar"},{"command":"bookmarks.export","title":"Export","category":"Bookmarks"}],"menus":{"commandPalette":[{"command":"_bookmarks.jumpTo","when":"false"},{"command":"_bookmarks.addBookmark#sideBar","when":"false"},{"command":"_bookmarks.search#sideBar","when":"false"},{"command":"bookmarks.refresh","when":"false"},{"command":"_bookmarks.clearFromAllFiles#sideBar","when":"false"},{"command":"_bookmarks.viewAsTree#sideBar","when":"false"},{"command":"_bookmarks.viewAsList#sideBar","when":"false"},{"command":"bookmarks.openSettings","when":"false"},{"command":"_bookmarks.sidebar.hidePosition","when":"false"},{"command":"_bookmarks.sidebar.showPosition","when":"false"},{"command":"_bookmarks.clearFromFile","when":"false"},{"command":"_bookmarks.deleteBookmark","when":"false"},{"command":"_bookmarks.editLabel","when":"false"},{"command":"_bookmarks.addBookmarkAtLine#gutter","when":"false"},{"command":"_bookmarks.addLabeledBookmarkAtLine#gutter","when":"false"},{"command":"_bookmarks.removeBookmarkAtLine#gutter","when":"false"},{"command":"_bookmarks.whatsNewContextMenu","when":"false"},{"command":"_bookmarks.openFolderWelcome","when":"false"},{"command":"_bookmarks.openSideBar","when":"false"}],"editor/context":[{"submenu":"bookmarks.editor.context","group":"bookmarks"}],"editor/title":[{"submenu":"bookmarks.editor.title","group":"bookmarks"}],"editor/lineNumber/context":[{"command":"_bookmarks.addBookmarkAtLine#gutter","when":"editorLineNumber not in bookmarks.linesWithBookmarks","group":"bookmarks"},{"command":"_bookmarks.addLabeledBookmarkAtLine#gutter","when":"editorLineNumber not in bookmarks.linesWithBookmarks","group":"bookmarks"},{"command":"_bookmarks.removeBookmarkAtLine#gutter","when":"editorLineNumber in bookmarks.linesWithBookmarks","group":"bookmarks"}],"view/title":[{"command":"_bookmarks.addBookmark#sideBar","when":"view == bookmarksExplorer","group":"navigation@5"},{"command":"_bookmarks.search#sideBar","when":"view == bookmarksExplorer","group":"navigation@7"},{"command":"bookmarks.refresh","when":"view == bookmarksExplorer","group":"navigation@10"},{"command":"_bookmarks.clearFromAllFiles#sideBar","when":"view == bookmarksExplorer","group":"navigation@11"},{"command":"_bookmarks.viewAsList#sideBar","when":"view == bookmarksExplorer && !bookmarks.viewAsList","group":"navigation@10"},{"command":"_bookmarks.viewAsTree#sideBar","when":"view == bookmarksExplorer && bookmarks.viewAsList","group":"navigation@10"},{"submenu":"bookmarks.sideBar.title","when":"view == bookmarksExplorer","group":"1_bookmarks"},{"command":"_bookmarks.sidebar.hidePosition","when":"view == bookmarksExplorer && !bookmarks.isHidingPosition","group":"2_bookmarks"},{"command":"_bookmarks.sidebar.showPosition","when":"view == bookmarksExplorer && bookmarks.isHidingPosition","group":"2_bookmarks"},{"command":"bookmarks.openSettings","when":"view == bookmarksExplorer","group":"3_bookmarks"}],"view/item/context":[{"command":"_bookmarks.clearFromFile","when":"view == bookmarksExplorer && viewItem == BookmarkNodeFile"},{"command":"_bookmarks.clearFromFile","when":"view == bookmarksExplorer && viewItem == BookmarkNodeFile","group":"inline"},{"command":"_bookmarks.deleteBookmark","when":"view == bookmarksExplorer && viewItem == BookmarkNodeBookmark","group":"bookmark@2"},{"command":"_bookmarks.deleteBookmark","when":"view == bookmarksExplorer && viewItem == BookmarkNodeBookmark","group":"inline@2"},{"command":"_bookmarks.editLabel","when":"view == bookmarksExplorer && viewItem == BookmarkNodeBookmark","group":"bookmark@1"},{"command":"_bookmarks.editLabel","when":"view == bookmarksExplorer && viewItem == BookmarkNodeBookmark","group":"inline@1"}],"extension/context":[{"command":"_bookmarks.whatsNewContextMenu","group":"bookmarks","when":"extension == alefragnani.bookmarks && extensionStatus == installed"}],"bookmarks.editor.context":[{"command":"bookmarks.toggle","group":"bookmarks","when":"editorTextFocus && config.bookmarks.showCommandsInContextMenu"},{"command":"bookmarks.toggleLabeled","group":"bookmarks","when":"editorTextFocus && config.bookmarks.showCommandsInContextMenu"},{"command":"bookmarks.jumpToNext","group":"bookmarks@1","when":"editorTextFocus && config.bookmarks.showCommandsInContextMenu"},{"command":"bookmarks.jumpToPrevious","group":"bookmarks@1","when":"editorTextFocus && config.bookmarks.showCommandsInContextMenu"}],"bookmarks.editor.title":[{"command":"bookmarks.list","group":"bookmarks"},{"command":"bookmarks.clear","group":"bookmarks"},{"command":"bookmarks.selectLines","group":"bookmarks"}],"bookmarks.sideBar.title":[{"command":"_bookmarks.viewAsTree#sideBar","group":"bookmarks#sideBar.view@1"},{"command":"_bookmarks.viewAsList#sideBar","group":"bookmarks#sideBar.view@2"}]},"submenus":[{"id":"bookmarks.editor.context","label":"Bookmarks"},{"id":"bookmarks.editor.title","label":"Bookmarks"},{"id":"bookmarks.sideBar.title","label":"View & Sort"}],"configuration":{"type":"object","title":"Bookmarks","properties":{"bookmarks.saveBookmarksInProject":{"type":"boolean","default":false,"description":"Allow bookmarks to be saved (and restored) locally in the opened Project/Folder instead of VS Code"},"bookmarks.gutterIconPath":{"type":"string","default":"","description":"Path to another image to be presented as Bookmark","scope":"machine","deprecationMessage":"Use `bookmarks.gutterIconFillColor` and `bookmarks.gutterIconBorderColor` instead"},"bookmarks.gutterIconFillColor":{"type":"string","format":"color","default":"#157EFB","description":"Specifies the fill color of the bookmark icon","scope":"application"},"bookmarks.gutterIconBorderColor":{"type":"string","format":"color","default":"#157EFB","description":"Specifies the border color of the bookmark icon","scope":"application"},"bookmarks.backgroundLineColor":{"type":"string","default":"","description":"Background color of the decoration. Use rgba() and define transparent background colors to play well with other decorations. Ex.: rgba(21, 126, 251, 0.1)","deprecationMessage":"Use `bookmarks.lineBackground` in `workbench.colorCustomizations` instead"},"bookmarks.navigateThroughAllFiles":{"type":"boolean","default":true,"description":"Allow navigation look for bookmarks in all files in the project, instead of only the current"},"bookmarks.wrapNavigation":{"type":"boolean","default":true,"description":"Allow navigation to wrap around at the first and last bookmarks in scope (current file or all files)"},"bookmarks.useWorkaroundForFormatters":{"type":"boolean","default":false,"description":"Use a workaround for formatters like Prettier, which does not notify on document changes and messes Bookmark's Sticky behavior"},"bookmarks.experimental.enableNewStickyEngine":{"type":"boolean","default":true,"description":"Experimental. Enables the new Sticky engine with support for Formatters, improved source change detections and undo operations"},"bookmarks.keepBookmarksOnLineDelete":{"type":"boolean","default":false,"description":"Specifies whether bookmarks on deleted line should be kept on file, moving it down to the next line, instead of deleting it with the line where it was toggled."},"bookmarks.showNoMoreBookmarksWarning":{"type":"boolean","default":true,"description":"Specifies whether a notification will be shown when attempting to navigate between bookmarks when no more exist."},"bookmarks.showCommandsInContextMenu":{"type":"boolean","default":true,"description":"Specifies whether Bookmarks commands are displayed on the context menu"},"bookmarks.sideBar.expanded":{"type":"boolean","default":false,"description":"Specifies whether the Side Bar show be displayed expanded"},"bookmarks.sideBar.countBadge":{"type":"string","default":"all","enum":["all","files","off"],"enumDescriptions":["Show the sum of bookmarks from all files","Show the sum of files that contains at least one bookmark","Disable the Bookmarks count badge"],"description":"Controls the count badge on the Bookmark icon on the Activity Bar"},"bookmarks.sideBar.hideWelcome":{"type":"boolean","default":false,"description":"Controls the visibility of the Welcome Views in the Side Bar"},"bookmarks.multicursor.toggleMode":{"type":"string","default":"allLinesAtOnce","enum":["allLinesAtOnce","eachLineIndependently"],"enumDescriptions":["Creates bookmarks in all selected lines at once, if at least one of the lines don't have a bookmark","Literally toggles a bookmark in each line, instead of making all lines equal"],"description":"Specifies how multi cursor handles already bookmarked lines"},"bookmarks.label.suggestion":{"type":"string","default":"dontUse","description":"Specifies how labels are suggested when creating bookmarks","enum":["dontUse","useWhenSelected","suggestWhenSelected","suggestWhenSelectedOrLineWhenNoSelected"],"enumDescriptions":["Don't use the selection (original behavior)","Use the selected text (if available) directly, no confirmation required","Suggests the selected text (if available). You still need to confirm.","Suggests the selected text (if available) or the entire line (when has no selection). You still need to confirm."]},"bookmarks.revealLocation":{"type":"string","default":"center","description":"Specifies the location where the bookmarked line will be revealed","enum":["top","center"],"enumDescriptions":["Reveals the bookmarked line at the top of the editor","Reveals the bookmarked line in the center of the editor"]},"bookmarks.overviewRulerLane":{"type":"string","default":"full","description":"Specifies the lane in the overview ruler where the bookmarked line will be shown","enum":["none","left","center","right","full"],"enumDescriptions":["Don't show the bookmarked line in the overview ruler","Show the bookmarked line in the left lane of the overview ruler","Show the bookmarked line in the center lane of the overview ruler","Show the bookmarked line in the right lane of the overview ruler","Show the bookmarked line in the full height of the overview ruler"]},"bookmarks.export.pattern":{"type":"string","default":"| $file | $line | $column | $label | $content |","description":"Specifies the export pattern for bookmarks. Available variables: $file, $line, $column, $label, $content","markdownDescription":"Specifies the export pattern for bookmarks. Available variables: `$file`, `$line`, `$column`, `$label`, `$content`"},"bookmarks.confirmClear":{"type":"string","default":"never","description":"Specifies when a confirmation message should be displayed before clearing bookmarks","enum":["never","always","commandPalette","sideBar"],"enumDescriptions":["Never show confirmation message","Always show confirmation message","Only show confirmation message when executed from the Command Palette","Only show confirmation message when executed from the Side Bar"]}}},"keybindings":[{"command":"bookmarks.toggle","key":"ctrl+alt+k","mac":"cmd+alt+k","when":"editorTextFocus"},{"command":"bookmarks.jumpToNext","key":"ctrl+alt+l","mac":"cmd+alt+l","when":"editorTextFocus"},{"command":"bookmarks.jumpToPrevious","key":"ctrl+alt+j","mac":"cmd+alt+j","when":"editorTextFocus"},{"command":"bookmarks.shrinkSelection","key":"shift+alt+k","mac":"shift+alt+k","when":"editorTextFocus"},{"command":"bookmarks.expandSelectionToNext","key":"shift+alt+l","mac":"shift+alt+l","when":"editorTextFocus"},{"command":"bookmarks.expandSelectionToPrevious","key":"shift+alt+j","mac":"shift+alt+j","when":"editorTextFocus"}],"colors":[{"id":"bookmarks.lineBackground","description":"Background color for the bookmarked line","defaults":{"dark":"#00000000","light":"#00000000","highContrast":"#00000000"}},{"id":"bookmarks.lineBorder","description":"Background color for the border around the bookmarked line","defaults":{"dark":"#00000000","light":"#00000000","highContrast":"#00000000"}},{"id":"bookmarks.overviewRuler","description":"Overview ruler marker color for bookmarks","defaults":{"dark":"#157EFB88","light":"#157EFB88","highContrast":"#157EFB88"}}],"walkthroughs":[{"id":"bookmarksWelcome","title":"Get Started with Bookmarks","description":"Learn more about Bookmarks to optimize your workflow","steps":[{"id":"toggle","title":"Toggle Bookmarks","description":"Easily Mark/Unmark Bookmarks at any position.\nAn icon is added to both the gutter and overview ruler to easily identify the lines with Bookmarks.","media":{"markdown":"walkthrough/toggle.md"}},{"id":"navigateToBookmarks","title":"Navigate to Bookmarks","description":"Quickly jump between bookmarked lines.\nSearch bookmarks using the line's content and/or labels.","media":{"markdown":"walkthrough/navigateToBookmarks.md"}},{"id":"defineLabelsForYourBookmarks","title":"Define labels for your bookmarks","description":"You can define labels for any bookmark, giving them an special meaning other than its position.","media":{"markdown":"walkthrough/defineLabelsForYourBookmarks.md"}},{"id":"exclusiveSideBar","title":"Exclusive Side Bar","description":"An exclusive Side Bar with everything you need to increase your productivity.\n[Open Side Bar](command:_bookmarks.openSideBar)","media":{"markdown":"walkthrough/exclusiveSideBar.md"}},{"id":"workingWithRemotes","title":"Working with Remotes","description":"The extension support [Remote Development](https://code.visualstudio.com/docs/remote/remote-overview) scenarios. Even installed locally, you can use Bookmarks in WSL, Containers, SSH and Codespaces.","media":{"markdown":"walkthrough/workingWithRemotes.md"}},{"id":"customizingAppearance","title":"Customizing Appearance","description":"Customize how Bookmarks are presented, its icon, line and overview ruler\n[Open Settings - Gutter Icon](command:workbench.action.openSettings?%5B%22bookmarks.gutterIcon%22%5D)\n[Open Settings - Line](command:workbench.action.openSettingsJson?%5B%22workbench.colorCustomizations%22%5D)","media":{"markdown":"walkthrough/customizingAppearance.md"}}]}]},"eslintConfig":{"extends":["vscode-ext"],"rules":{"indent":["error",4,{"SwitchCase":1}],"no-tabs":"error","semi":["error","always"],"no-unexpected-multiline":"error"}},"scripts":{"build":"webpack --mode development","watch":"webpack --watch --mode development","vscode:prepublish":"webpack --mode production","webpack":"webpack --mode development","webpack-dev":"webpack --mode development --watch","compile":"tsc -p ./","lint":"eslint -c package.json --ext .ts src vscode-whats-new","pretest":"npm run compile && npm run lint","test-compile":"tsc -p ./ && npm run webpack","just-test":"node ./out/src/test/runTest.js","test":"npm run test-compile && npm run just-test"},"dependencies":{"os-browserify":"^0.3.0","path-browserify":"^1.0.1","vscode-ext-codicons":"^1.0.0","vscode-ext-decoration":"1.1.0","vscode-ext-help-and-feedback-view":"^1.0.1","vscode-ext-selection":"1.0.0"},"devDependencies":{"@types/glob":"^8.1.0","@types/mocha":"^10.0.0","@types/node":"^22.18.10","@types/vscode":"^1.78.0","@typescript-eslint/eslint-plugin":"^6.21.0","@typescript-eslint/parser":"^6.21.0","@vscode/test-electron":"^2.5.2","eslint":"^8.1.0","eslint-config-vscode-ext":"^1.1.0","mocha":"^11.1.0","terser-webpack-plugin":"^5.2.4","ts-loader":"^9.2.5","typescript":"^5.3.3","webpack":"^5.105.2","webpack-cli":"^4.8.0"}},"location":{"$mid":1,"path":"/D:/All/IDLE/t/VSCodium/data/extensions/alefragnani.bookmarks-14.1.1-universal","scheme":"file"},"isBuiltin":false,"targetPlatform":"universal","publisherDisplayName":"alefragnani","metadata":{"installedTimestamp":1788356913100,"pinned":false,"source":"gallery","id":"b689fcc8-d494-4dbf-a228-2c694a578afc","publisherId":"3fbdef65-bdf5-4723-aeaf-9e12a50546ef","publisherDisplayName":"alefragnani","targetPlatform":"universal","updated":false,"private":false,"isPreReleaseVersion":false,"hasPreReleaseVersion":false,"size":6665401},"isValid":true,"validations":[],"preRelease":false,"forceAutoUpdate":false},{"type":1,"identifier":{"id":"hirse.vscode-ungit","uuid":"eb0752c6-48d3-44d2-9f44-bf239bdda2ad"},"manifest":{"name":"vscode-ungit","displayName":"Ungit","description":"Ungit in Visual Studio Code.","icon":"images/logo.png","version":"2.5.2","publisher":"Hirse","galleryBanner":{"color":"#252833","theme":"dark"},"license":"MIT","bugs":"https://github.com/hirse/vscode-ungit/issues","homepage":"https://github.com/hirse/vscode-ungit","repository":{"type":"git","url":"https://github.com/hirse/vscode-ungit.git"},"categories":["Other"],"keywords":["ungit","git","multi-root ready"],"engines":{"vscode":"^1.75.0"},"main":"./out/src/extension","contributes":{"configuration":{"title":"Ungit","properties":{"ungit.showButton":{"type":"boolean","default":false,"description":"Show a button in the editor title bar to open Ungit","scope":"resource"},"ungit.showInActiveColumn":{"type":"boolean","default":false,"description":"Open the Ungit view in the active editor column instead of on the side","scope":"resource"}}},"commands":[{"command":"extension.ungit","title":"Open Ungit","icon":{"dark":"./images/icon-dark.svg","light":"./images/icon-light.svg"}}],"menus":{"editor/title":[{"when":"config.ungit.showButton","command":"extension.ungit","group":"navigation"}]},"keybindings":[{"command":"extension.ungit","key":"shift+alt+u","mac":"shift+alt+u"}]},"scripts":{"build":"tsc","compile":"tsc -watch","package":"vsce package","publish":"vsce publish","test":"eslint src/*"},"dependencies":{"ungit":"1.5.24","vscode-extension-telemetry":"0.4.5"},"devDependencies":{"@types/node":"16.x.x","@types/vscode":"1.75.x","@typescript-eslint/eslint-plugin":"6.x.x","@typescript-eslint/parser":"6.x.x","@vscode/vsce":"^2.20.x","eslint":"8.x.x","typescript":"5.1.x"}},"location":{"$mid":1,"path":"/D:/All/IDLE/t/VSCodium/data/extensions/hirse.vscode-ungit-2.5.2-universal","scheme":"file"},"isBuiltin":false,"targetPlatform":"universal","publisherDisplayName":"Hirse","metadata":{"installedTimestamp":1788541631330,"pinned":false,"source":"gallery","id":"eb0752c6-48d3-44d2-9f44-bf239bdda2ad","publisherId":"77319816-5902-4f0f-a9ac-33090a728771","publisherDisplayName":"Hirse","targetPlatform":"universal","updated":false,"private":false,"isPreReleaseVersion":false,"hasPreReleaseVersion":false,"size":95624817},"isValid":true,"validations":[],"preRelease":false,"forceAutoUpdate":false},{"type":1,"identifier":{"id":"jakubkozera.csharp-dev-tools","uuid":"abb25771-7cbe-4e0e-baa1-5c4914848f3c"},"manifest":{"name":"csharp-dev-tools","displayName":"C# Dev Tools","description":"Enhanced development tools for C# and .NET in VS Code","version":"1.11.2","lspVersion":"1.8.0","publisher":"JakubKozera","icon":"csharp-dev-tools.png","homepage":"https://jakubkozera.github.io/vsc-csharp-dev-tools/","engines":{"vscode":"^1.100.0"},"sponsor":{"url":"https://github.com/sponsors/jakubkozera"},"repository":{"type":"git","url":"https://github.com/jakubkozera/vsc-csharp-dev-tools.git"},"license":"https://raw.githubusercontent.com/jakubkozera/vsc-csharp-dev-tools/refs/heads/main/LICENSE.MD","categories":["Linters","Debuggers","Programming Languages","Testing"],"keywords":["C#","csharp",".NET",".NET Core","dotnet","ASP.NET","ASP.NET Razor","Razor","aspnetcore","blazor","NuGet","NuGet package manager","NUnit","MSTest","xUnit","Unit Testing","solution","sln","slnx","IntelliSense","code analysis","code completion","code generation","refactor","rename","navigation","keybindings","xaml","dev kit","devkit"],"extensionDependencies":[],"activationEvents":["workspaceContains:**/*.sln","workspaceContains:**/*.slnx","workspaceContains:**/*.razor","workspaceContains:**/*.cshtml","onStartupFinished","onLanguage:csharp","onLanguage:razor","onLanguage:aspnetcorerazor","onDebugResolve:devtools","onDebugResolve:coreclr","onDebugResolve:unity"],"main":"./dist/extension.js","contributes":{"icons":{"csharp-broom":{"description":"Broom","default":{"fontPath":"./media/fonts/broom4.woff","fontCharacter":"\\E001"}}},"languageModelTools":[{"name":"csharp-dev-tools_build_dotnet","tags":["dotnet","build","csharp-dev-tools"],"toolReferenceName":"buildDotnet","displayName":"Build .NET","modelDescription":"Build a .NET solution or project using C# Dev Tools. It uses the user's selected build configuration, target framework for project targets, terminal preference, NuGet credential handling, and build diagnostics. Use this instead of a generic terminal build whenever the user asks to build .NET code. It returns only a concise success message or the same structured build-error summary shown by C# Dev Tools. Do not use it to run tests.","canBeReferencedInPrompt":true,"icon":"$(tools)","inputSchema":{"type":"object","properties":{"target_path":{"type":"string","description":"Optional absolute path to a .sln, .slnx, or .csproj file. Omit it only when exactly one solution is loaded."}}},"when":"workspaceFolderCount > 0"},{"name":"csharp-dev-tools_test_dotnet","tags":["dotnet","test","csharp-dev-tools"],"toolReferenceName":"testDotnet","displayName":"Test .NET","modelDescription":"Run .NET tests through the C# Dev Tools test runner at project, namespace, class, or individual-test scope. It respects the user's selected build configuration, target framework, detected test runner mode, .runsettings file, integrated build behavior, and NuGet credential handling. Use this instead of a generic terminal test command when a test project path is known. Set test_scope to project to run all tests, namespace for one namespace, class for one fully qualified test class, or test for one fully qualified test method. test_name is required for every scope except project. It returns only a concise success message, structured test failures, or a structured build-error summary when the required build fails. Do not use it for non-test projects.","canBeReferencedInPrompt":true,"icon":"$(beaker)","inputSchema":{"type":"object","properties":{"project_path":{"type":"string","description":"Absolute path to the .csproj test project whose tests should run."},"test_scope":{"type":"string","enum":["project","namespace","class","test"],"default":"project","description":"The test granularity: project runs all project tests; namespace, class, and test select a specific target."},"test_name":{"type":"string","description":"Required when test_scope is namespace, class, or test. Use the fully qualified namespace, class, or test method name respectively."}},"required":["project_path"]},"when":"workspaceFolderCount > 0"},{"name":"csharp-dev-tools_add_ef_migration","tags":["dotnet","entity-framework","migration","csharp-dev-tools"],"toolReferenceName":"addEfMigration","displayName":"Add EF Migration","modelDescription":"Create an Entity Framework Core migration using the same workflow as C# Dev Tools' Add Entity Framework Migration Run button. It builds the selected startup or migrations project first, applies NuGet credentials, runs dotnet ef migrations add with --no-build, saves the migration preferences, opens the created migration file, and returns a concise result. Use it when the user explicitly asks to create an EF Core migration. migrations_project_path is the project containing the DbContext and generated migrations. startup_project_path is optional but should be supplied when the application startup project differs. db_context_class and migrations_folder are optional and map directly to the dialog fields.","canBeReferencedInPrompt":true,"icon":"$(database)","inputSchema":{"type":"object","properties":{"migration_name":{"type":"string","description":"Required migration class name, for example InitialCreate or AddUserTable."},"migrations_project_path":{"type":"string","description":"Required absolute path to the .csproj that contains the DbContext and where migrations are generated."},"startup_project_path":{"type":"string","description":"Optional absolute path to the startup .csproj used to load application configuration and connection strings."},"db_context_class":{"type":"string","description":"Optional DbContext class name for solutions with multiple DbContexts."},"migrations_folder":{"type":"string","description":"Optional migrations output directory relative to the migrations project, for example Migrations or Data/Migrations."}},"required":["migration_name","migrations_project_path"]},"when":"workspaceFolderCount > 0"},{"name":"csharp-dev-tools_create_diagram","tags":["diagram","excalidraw","architecture","csharp-dev-tools"],"toolReferenceName":"createDiagram","displayName":"Create or Update Diagram","modelDescription":"Create a local editable Excalidraw diagram or iteratively update an existing one in the C# Dev Tools editor. Use this for architecture, flow, sequence, deployment, data-flow, class, and infrastructure diagrams. For a new diagram pass diagram_name; it is stored under .vscodecsdt/Diagrams and opened immediately. To modify a diagram returned by an earlier call, pass its absolute diagram_path and operation 'merge', reuse stable element ids to replace elements, and use delete_element_ids to remove elements. The open canvas updates live after every call so the user can watch the work. Build a clear left-to-right or top-to-bottom layout with at least 60px gaps, short labels, consistent colors, and arrows after their endpoint shapes. Prefer 220x100 nodes, section headings as text, and a restrained palette. Keep connectors away from unrelated nodes and avoid crossing labels or other connectors. Use icon elements with icon_name for recognizable Azure resources or common Tabler symbols; bundled SVGs are matched and embedded into the file. For an icon set icon_source to azure or tabler when the intended family matters. Arrows bind to shape edges through start_element_id and end_element_id. Use operation 'replace' only when intentionally rebuilding the whole canvas. The tool returns an automatic quality report and, on supported VS Code versions, a rendered PNG. You MUST inspect that result for clipped text, overlaps, awkward spacing, connector crossings, visual hierarchy, and overall polish. If any issue remains, call this same tool again with the returned diagram_path and operation 'merge'. Do not claim completion until the automatic report is clean and the rendered diagram is visually satisfactory.","canBeReferencedInPrompt":true,"icon":"$(graph)","inputSchema":{"type":"object","properties":{"diagram_name":{"type":"string","description":"Name for a new workspace diagram. Omit when diagram_path identifies an existing diagram."},"diagram_path":{"type":"string","description":"Absolute path to an existing .excalidraw file to update. Reuse the path returned by an earlier call."},"operation":{"type":"string","enum":["replace","merge"],"description":"replace rebuilds the scene from the supplied elements; merge preserves other elements and upserts supplied stable ids. Defaults to replace for new files and merge for existing files."},"background_color":{"type":"string","description":"Optional canvas background as a hex color."},"delete_element_ids":{"type":"array","items":{"type":"string"},"description":"Stable ids to remove during a merge. Connected arrows and generated labels are cleaned up automatically."},"elements":{"type":"array","description":"Elements to create or upsert. Shapes with text get centered, wrapped labels automatically.","items":{"type":"object","properties":{"id":{"type":"string","description":"Required stable id using letters, numbers, hyphens, or underscores. Reuse it to update this element later."},"type":{"type":"string","enum":["rectangle","ellipse","diamond","text","arrow","line","icon"]},"x":{"type":"number"},"y":{"type":"number"},"width":{"type":"number"},"height":{"type":"number"},"text":{"type":"string","description":"Label for a shape or content for a text element."},"start_element_id":{"type":"string","description":"For arrows or lines, stable id of the source shape."},"end_element_id":{"type":"string","description":"For arrows or lines, stable id of the destination shape."},"points":{"type":"array","items":{"type":"array","items":{"type":"number"},"minItems":2,"maxItems":2},"description":"Optional points relative to x/y for an unbound arrow or line."},"icon_name":{"type":"string","description":"Search phrase for a bundled Azure or Tabler SVG, for example app service, sql database, service bus, user, or cloud."},"icon_source":{"type":"string","enum":["azure","tabler"]},"stroke_color":{"type":"string"},"background_color":{"type":"string"},"text_color":{"type":"string"},"font_size":{"type":"number"},"stroke_style":{"type":"string","enum":["solid","dashed","dotted"]},"fill_style":{"type":"string","enum":["solid","hachure","cross-hatch"]},"roughness":{"type":"number","minimum":0,"maximum":2},"opacity":{"type":"number","minimum":0,"maximum":100}},"required":["id","type"]}}},"anyOf":[{"required":["diagram_name"]},{"required":["diagram_path"]}]},"when":"workspaceFolderCount > 0"},{"name":"csharp-dev-tools_create_debug_runner","tags":["dotnet","debug","runner","csharp-dev-tools"],"toolReferenceName":"createDebugRunner","displayName":"Create Debug Runner","modelDescription":"Scaffold a C# Dev Tools runner that reproduces a bug and write a provided C# body into its Run() method. A runner is a lightweight entry point that wires up the target project's dependency-injection container and lets you invoke code directly under the debugger without starting the full application. Use this as the first step of an agentic debugging flow: given a description or stack trace, generate a minimal reproduction body. If a runner project does not yet exist for the source project it is created automatically. source_project_path is the absolute path to the .csproj to reproduce against. runner_name is a PascalCase C# class name. runner_body contains the C# statements placed inside 'public async Task Run()'. services is the list of dependencies to inject through the runner constructor - ALWAYS pass the services your runner_body needs (prefer interfaces such as IOrderService) so the code compiles immediately without a fix-up loop; each injected service is resolved from the project's DI container and exposed as a field with the given (or derived camelCase) name that runner_body can reference directly (e.g. orderService). usings is an optional list of additional namespaces. Returns the created runner file path and class name. After creating, set breakpoints and call debug_run_runner.","canBeReferencedInPrompt":true,"icon":"$(debug-console)","inputSchema":{"type":"object","properties":{"source_project_path":{"type":"string","description":"Absolute path to the .csproj to reproduce the bug against."},"runner_name":{"type":"string","description":"PascalCase C# class name for the runner, for example OrderBugRunner."},"runner_body":{"type":"string","description":"C# statements to place inside 'public async Task Run()'. Use these to reproduce the bug. Reference any injected services by their field name (e.g. orderService)."},"services":{"type":"array","description":"Dependencies to inject through the runner constructor. Pass every service the runner_body uses so it compiles on the first try. Prefer interface types that are registered in the project's DI container.","items":{"type":"object","properties":{"type":{"type":"string","description":"The C# service type to inject, preferably an interface, for example IOrderService."},"name":{"type":"string","description":"Optional field/parameter name for the service. Defaults to a camelCase name derived from the type (leading interface 'I' dropped), e.g. IOrderService becomes orderService."}},"required":["type"]}},"usings":{"type":"array","items":{"type":"string"},"description":"Optional additional namespaces to import (e.g. MyApp.Services). Each entry may be a bare namespace or a full 'using X;' statement. Include the namespaces of any injected service types."}},"required":["source_project_path","runner_name","runner_body"]},"when":"workspaceFolderCount > 0"},{"name":"csharp-dev-tools_debug_set_breakpoints","tags":["dotnet","debug","csharp-dev-tools"],"toolReferenceName":"debugSetBreakpoints","displayName":"Set Breakpoints","modelDescription":"Add source breakpoints in C# files before running the debugger. Supports conditional breakpoints (condition), hit-count conditions (hitCondition) and logpoints (logMessage). Use this to mark the critical locations you want to inspect while diagnosing a bug. Set replace_existing to true to first remove breakpoints previously added by this tool. Returns the breakpoints that were set. Breakpoints may show as unverified until a debug session is running.","canBeReferencedInPrompt":true,"icon":"$(debug-breakpoint)","inputSchema":{"type":"object","properties":{"breakpoints":{"type":"array","description":"The breakpoints to set.","items":{"type":"object","properties":{"file":{"type":"string","description":"Absolute path to the .cs file."},"line":{"type":"number","description":"1-based line number for the breakpoint."},"condition":{"type":"string","description":"Optional C# boolean expression; the breakpoint only triggers when it is true."},"hitCondition":{"type":"string","description":"Optional hit-count condition, for example '>= 5'."},"logMessage":{"type":"string","description":"Optional logpoint message; when set, execution logs instead of stopping. Use {expr} to interpolate expressions."}},"required":["file","line"]}},"replace_existing":{"type":"boolean","description":"When true, remove breakpoints previously added by this tool before adding the new ones."}},"required":["breakpoints"]},"when":"workspaceFolderCount > 0"},{"name":"csharp-dev-tools_debug_run_runner","tags":["dotnet","debug","runner","csharp-dev-tools"],"toolReferenceName":"debugRunRunner","displayName":"Run Runner (Debug)","modelDescription":"Build and launch a runner under the .NET debugger and wait until it hits a breakpoint, terminates, or times out. runner_file_path is the absolute path returned by create_debug_runner. method_name optionally targets a single method (defaults to Run). timeout_ms bounds how long to wait for the first stop (default 30000). Returns a stop summary: status 'stopped' with the top stack frame and thread id, 'terminated' when the program finished without stopping (includes console output), or 'timeout'. After a stop, use debug_get_state, debug_evaluate, debug_step and debug_continue to investigate, then debug_stop to end the session.","canBeReferencedInPrompt":true,"icon":"$(debug-alt)","inputSchema":{"type":"object","properties":{"runner_file_path":{"type":"string","description":"Absolute path to the runner .cs file to debug."},"method_name":{"type":"string","description":"Optional runner method to invoke. Defaults to Run."},"timeout_ms":{"type":"number","description":"Maximum time in milliseconds to wait for the first stop. Default 30000."}},"required":["runner_file_path"]},"when":"workspaceFolderCount > 0"},{"name":"csharp-dev-tools_debug_get_state","tags":["dotnet","debug","csharp-dev-tools"],"toolReferenceName":"debugGetState","displayName":"Get Debug State","modelDescription":"Inspect the current paused state of the managed debug session. Returns the call stack for the stopped thread and, unless include_variables is false, the local variables of the selected frame. thread_id defaults to the last stopped thread. frame_index selects a stack frame (0 = top). Use this after a breakpoint stop to collect the data needed to diagnose a bug.","canBeReferencedInPrompt":true,"icon":"$(debug-stackframe)","inputSchema":{"type":"object","properties":{"thread_id":{"type":"number","description":"Optional stopped thread id. Defaults to the last stopped thread."},"frame_index":{"type":"number","description":"Optional 0-based stack frame index. Defaults to 0 (top frame)."},"include_variables":{"type":"boolean","description":"Whether to include local variables for the selected frame. Defaults to true."}}},"when":"workspaceFolderCount > 0"},{"name":"csharp-dev-tools_debug_evaluate","tags":["dotnet","debug","csharp-dev-tools"],"toolReferenceName":"debugEvaluate","displayName":"Evaluate Expression","modelDescription":"Evaluate a C# expression in the context of a paused debug frame and return its value and type. Use this to probe object state, call simple property getters, or check conditions while stopped at a breakpoint. frame_index selects the stack frame (0 = top); thread_id defaults to the last stopped thread. Requires an active managed debug session that is paused.","canBeReferencedInPrompt":true,"icon":"$(debug-console)","inputSchema":{"type":"object","properties":{"expression":{"type":"string","description":"The C# expression to evaluate."},"frame_index":{"type":"number","description":"Optional 0-based stack frame index to evaluate in. Defaults to 0 (top frame)."},"thread_id":{"type":"number","description":"Optional stopped thread id. Defaults to the last stopped thread."}},"required":["expression"]},"when":"workspaceFolderCount > 0"},{"name":"csharp-dev-tools_debug_continue","tags":["dotnet","debug","csharp-dev-tools"],"toolReferenceName":"debugContinue","displayName":"Continue Execution","modelDescription":"Resume the paused debug session and wait for the next breakpoint, termination, or timeout. thread_id defaults to the last stopped thread. timeout_ms bounds the wait (default 30000). Returns the same stop summary shape as debug_run_runner. Use this to advance between breakpoints while investigating.","canBeReferencedInPrompt":true,"icon":"$(debug-continue)","inputSchema":{"type":"object","properties":{"thread_id":{"type":"number","description":"Optional thread id to continue. Defaults to the last stopped thread."},"timeout_ms":{"type":"number","description":"Maximum time in milliseconds to wait for the next stop. Default 30000."}}},"when":"workspaceFolderCount > 0"},{"name":"csharp-dev-tools_debug_step","tags":["dotnet","debug","csharp-dev-tools"],"toolReferenceName":"debugStep","displayName":"Step Execution","modelDescription":"Perform a single debugger step and wait for the resulting stop. step_type selects 'over' (step over the current line), 'in' (step into a call), or 'out' (step out of the current method). thread_id defaults to the last stopped thread. timeout_ms bounds the wait (default 30000). Returns the same stop summary shape as debug_run_runner. Use this to trace execution line by line while diagnosing a bug.","canBeReferencedInPrompt":true,"icon":"$(debug-step-over)","inputSchema":{"type":"object","properties":{"step_type":{"type":"string","enum":["over","in","out"],"description":"The kind of step to perform."},"thread_id":{"type":"number","description":"Optional stopped thread id. Defaults to the last stopped thread."},"timeout_ms":{"type":"number","description":"Maximum time in milliseconds to wait for the next stop. Default 30000."}},"required":["step_type"]},"when":"workspaceFolderCount > 0"},{"name":"csharp-dev-tools_debug_stop","tags":["dotnet","debug","csharp-dev-tools"],"toolReferenceName":"debugStop","displayName":"Stop Debugging","modelDescription":"Stop the managed runner debug session and return the tail of its console output. Set remove_breakpoints to true to also remove the breakpoints previously added by debug_set_breakpoints. Call this when the investigation is complete, before or after applying a fix. If no session is active, returns status 'no_session'.","canBeReferencedInPrompt":true,"icon":"$(debug-stop)","inputSchema":{"type":"object","properties":{"remove_breakpoints":{"type":"boolean","description":"When true, remove the breakpoints previously added by debug_set_breakpoints."}}},"when":"workspaceFolderCount > 0"}],"walkthroughs":[{"id":"csharpExtension","title":"C# Dev Tools","description":"Learn how to use all the enhanced C# features","when":"workspaceFolderCount > 0","steps":[{"id":"solutionViewer","title":"Solution Explorer","description":"The enhanced Solution Explorer provides a familiar Visual Studio-like experience for .NET development in VS Code.\n\n**Solution Structure:** View all projects, solution folders, references, and files\n**Context Menu:** Access build operations, manage user secrets, NuGet management, and more\n**File Management:** Create, move, and organize files directly in the Solution Explorer\n\n[Open Solution Explorer](command:csharp-dev-tools.openSolutionViewer)","media":{"image":"media/walkthroughs/solution-explorer.png","altText":"Solution Explorer view"},"completionEvents":["onCommand:csharp-dev-tools.openSolutionViewer"]},{"id":"testExplorer","title":"Test Explorer","description":"Run and debug your .NET tests directly from VS Code.\n\n**Automatic discovery** of tests in your solution\n**Run tests** individually, by group, or the entire solution\n**View test results** and navigate directly to test failures\n\n[Open Testing View](command:workbench.view.testing.focus)","media":{"image":"media/walkthroughs/test-explorer.png","altText":"Test Explorer view"},"completionEvents":["onView:workbench.view.testing","onCommand:workbench.view.testing.focus"]},{"id":"advancedSearch","title":"Advanced Search","description":"Quickly find and navigate to C# types and symbols in your codebase.\n\nPress **Alt+P** to open the search dialog\nSearch for **types** (classes, interfaces, enums, structs, records)\nFind **members** using @methodName syntax\nSearch within specific types with TypeName@memberName syntax\n\n[Open Advanced Search](command:csharp-dev-tools.advancedSearch)","media":{"image":"media/walkthroughs/advanced-search.png","altText":"Advanced Search interface"},"completionEvents":["onCommand:csharp-dev-tools.advancedSearch"]},{"id":"nugetManagement","title":"NuGet Package Management","description":"Manage NuGet packages directly from the Solution Explorer.\n\n**Open** the NuGet Manager by right-clicking on a project or using the button below\n**Browse** for new packages to install\n**Update** existing packages to newer versions\n**Remove** packages you no longer need\n\nThe NuGet Manager will automatically detect your solution file.\n\n[Open NuGet Manager](command:nugetManager.openPackageManager)","media":{"image":"media/walkthroughs/nuget-manager.png","altText":"NuGet Package Manager interface"},"completionEvents":["onCommand:nugetManager.openPackageManager"]},{"id":"projectCreation","title":"Project Creation","description":"Create new .NET projects directly from VS Code.\n\n**Project Templates:** Access standard .NET project templates\n**Solution Integration:** Automatically add new projects to your solution\n**Configuration:** Set up project properties during creation\n\n[Create New Project](command:solutionViewer.newProject)","media":{"image":"media/walkthroughs/project-creation.png","altText":"New project creation dialog"},"completionEvents":["onCommand:solutionViewer.newProject"]},{"id":"quickAdd","title":"Quick Add","description":"Quickly add new files, classes, and components to your project with Shift+F2.\n\n**Fast File Creation:** Press Shift+F2 when focused on the Solution Explorer to instantly add new items\n**Smart Templates:** Choose from C# classes, interfaces, enums, records, controllers, Razor pages, and more\n**JSON to C# Conversion:** Paste JSON objects to automatically generate C# classes with proper attributes\n**Context-Aware:** Automatically adds files to the correct project folder based on your selection\n**No Menu Navigation:** Skip right-click menus and create files instantly\n\nTry it now by selecting a project or folder in the Solution Explorer and pressing Shift+F2!\n\n**New JSON Feature:** You can now paste JSON like `{\"name\":\"John\",\"age\":30}Address.cs` to create C# classes!\n\n[Open Solution Explorer](command:csharp-dev-tools.openSolutionViewer)","media":{"image":"media/walkthroughs/quick-add.png","altText":"Quick Add feature showing file creation dialog"},"completionEvents":["onCommand:solutionViewer.addNewFile","onCommand:solutionViewer.addClass","onCommand:solutionViewer.addInterface"]},{"id":"editorFeatures","title":"Editor Features","description":"Take advantage of enhanced C# editing features:\n\n**Type Inlay Hints:** See inferred types for var declarations\n**Unused Symbol Highlighting:** Easily identify dead code\n**Navigation Shortcuts:**\n  Shift+Alt+L: Reveal current file in Solution Explorer\n\nToggle these features from the Command Palette or extension settings.\n\n[Open Settings](command:workbench.action.openSettings?%22csharp-dev-tools%22)","media":{"image":"media/walkthroughs/editor-features.png","altText":"Editor features showing inlay hints and navigation"},"completionEvents":["onCommand:solutionViewer.toggleInlayHints","onCommand:workbench.action.openSettings"]}]}],"colors":[{"id":"csharpDevTools.runButtonColor","description":"Color of the Run (without debugger) button in the status bar and editor title","defaults":{"dark":"#89D185","light":"#1B7C37","highContrast":"#00FF00","highContrastLight":"#007000"}},{"id":"csharpDevTools.debugButtonColor","description":"Color of the Debug button in the status bar and editor title","defaults":{"dark":"#F88070","light":"#C62828","highContrast":"#FF0000","highContrastLight":"#B71C1C"}},{"id":"csharpDevTools.semanticColor.interface","description":"Color for C# interface tokens in the editor","defaults":{"dark":"#b8ce82","light":"#2e7d32","highContrast":"#b8ce82","highContrastLight":"#1b5e20"}},{"id":"csharpDevTools.semanticColor.enum","description":"Color for C# enum tokens in the editor","defaults":{"dark":"#b8ce82","light":"#7b1fa2","highContrast":"#b8ce82","highContrastLight":"#4a148c"}},{"id":"csharpDevTools.semanticColor.namespace","description":"Color for C# namespace tokens in the editor","defaults":{"dark":"#cccccc","light":"#616161","highContrast":"#cccccc","highContrastLight":"#424242"}},{"id":"csharpDevTools.semanticColor.struct","description":"Color for C# struct tokens in the editor","defaults":{"dark":"#86C691","light":"#0277bd","highContrast":"#86C691","highContrastLight":"#01579b"}}],"viewsContainers":{"activitybar":[{"id":"csharpDevTools","title":"C# Dev Tools","icon":"icons/csharp.svg"}]},"views":{"csharpDevTools":[{"id":"solutionViewer","name":"Solution Explorer","canSelectMany":true,"icon":"$(folder-library)"},{"id":"toolsViewer","name":"Tools","icon":"$(tools)","visibility":"visible"},{"id":"solutions","name":"Solutions","icon":"$(folder-library)","visibility":"visible"}],"scm":[{"id":"pullRequests","name":"Pull Requests","icon":"$(git-pull-request)","visibility":"visible"}],"debug":[{"id":"csharp-dev-tools.runDebugProjects","name":"Run C# Projects","icon":"$(debug-alt)","visibility":"visible","when":"csharpExtensionActive && solutionViewer.solutionFound"},{"id":"csharp-dev-tools.performanceMonitor","name":"Performance Monitor","type":"webview","icon":"$(graph)","visibility":"visible","when":"csharpExtensionActive && solutionViewer.solutionFound && inDebugMode"},{"id":"csharp-dev-tools.modulesView","name":"Modules","icon":"$(symbol-namespace)","when":"debugType == coreclr || debugType == unity"},{"id":"myCallStack","name":"My Call Stack","icon":"$(debug-stackframe)","visibility":"visible","when":"inDebugMode"}],"test":[{"id":"csharp-test-coverage","name":"Test Coverage","icon":"$(percentage)","visibility":"visible","when":"csharpExtensionActive && solutionViewer.solutionFound"},{"id":"runSettingsView","name":"Run Settings","type":"webview","icon":"$(gear)","visibility":"visible","when":"runSettingsViewVisible"},{"id":"playwrightTests","name":"Playwright","type":"webview","icon":"$(browser)","visibility":"visible","when":"playwrightTestsVisible"}]},"languages":[{"id":"csharp","aliases":["C#","CSharp","csharp"],"extensions":[".cs",".csx",".cake"],"configuration":"./csharp-language-configuration.json"},{"id":"solution","aliases":["Visual Studio Solution","Solution",".NET",".NET Core","ASP.NET","ASP.NET Razor","Razor","aspnetcore","razor","blazor","C#","code analysis","code completion","code generation","dev kit","devkit","dotnet","format","generate","IntelliSense","keybindings","MSTest","navigation","NuGet","NuGet package manager","NUnit","productivity","razor","refactor","rename","sln","slnx","solution","Unit Testing","xaml","xUnit"],"extensions":[".sln"],"icon":{"light":"./icons/Solution.png","dark":"./icons/Solution.png"}},{"id":"xml","extensions":[".esproj"]},{"id":"gherkin","aliases":["Gherkin","feature","SpecFlow"],"extensions":[".feature"],"configuration":"./language-configuration.json","icon":{"light":"./icons/Cucumber.png","dark":"./icons/Cucumber.png"}},{"id":"razor","aliases":["Razor Component","Blazor","razor"],"extensions":[".razor"],"configuration":"./razor-language-configuration.json"},{"id":"aspnetcorerazor","aliases":["ASP.NET Razor","Razor Page","cshtml"],"extensions":[".cshtml"],"configuration":"./razor-language-configuration.json"}],"configurationDefaults":{"[csharp]":{"editor.formatOnType":true},"[razor]":{"editor.formatOnType":true},"[aspnetcorerazor]":{"editor.formatOnType":true},"emmet.includeLanguages":{"razor":"html","aspnetcorerazor":"html"},"files.readonlyInclude":{"**/_decompiled_/**":true}},"grammars":[{"language":"gherkin","scopeName":"text.gherkin.feature","path":"./syntaxes/gherkin.tmLanguage.json"},{"language":"solution","scopeName":"source.solution","path":"./syntaxes/solution.tmLanguage.json"},{"scopeName":"source.cs","language":"csharp","path":"./syntaxes/csharp-markdown-injection.json"},{"language":"razor","scopeName":"text.html.razor","path":"./syntaxes/aspnetcorerazor.tmLanguage.json","embeddedLanguages":{"source.cs":"csharp","text.html.basic":"html"}},{"language":"aspnetcorerazor","scopeName":"text.html.cshtml","path":"./syntaxes/cshtml.tmLanguage.json","embeddedLanguages":{"source.cs":"csharp","text.html.basic":"html"}}],"semanticTokenScopes":[{"language":"csharp","scopes":{"keyword":["keyword.cs"],"controlKeyword":["keyword.control.cs"],"delegate":["entity.name.type.delegate.cs"],"field":["entity.name.variable.field.cs"],"inactive":["comment.block.disabled.cs"]}}],"commands":[{"command":"csharp-dev-tools.showDemoWebview","title":"Show Demo Webview (React + TypeScript + Vite)","category":"C# Dev Tools"},{"command":"csharp-dev-tools.toggleCoverageDecorations","title":"Toggle Coverage Decorations","category":"C# Dev Tools","icon":"$(eye)"},{"command":"csharp-dev-tools.showCoverageViewer","title":"Open Coverage Dashboard","category":"C# Dev Tools","icon":"$(graph)"},{"command":"csharp-dev-tools.goToDefinition","title":"Go to Definition"},{"command":"csharp-dev-tools.openSolutionViewer","title":"Open Solution Explorer","category":"C# Solution Explorer"},{"command":"csharp-dev-tools.openLaunchConfigurations","title":"Open Launch Configurations","category":"C# Solution Explorer"},{"command":"csharp-dev-tools.configureSolutionLaunchConfigurations","title":"Configure multiple projects","category":"C# Solution Explorer"},{"command":"csharp-dev-tools.restartLanguageServer","title":"Restart C# Language Server","category":"C# Dev Tools"},{"command":"csharp-dev-tools.openWalkthroughs","title":"Open Extension Walkthroughs","category":"C# Solution Explorer"},{"command":"csharp-dev-tools.createTests","title":"Create Tests","category":"C# Solution Explorer"},{"command":"csharp-dev-tools.goToImplementation","title":"Go to Implementation","category":"C# Solution Explorer"},{"command":"csharp-dev-tools.regexTester","title":"Regular Expression Tester","category":"C# Dev Tools"},{"command":"csharp-dev-tools.textComparer","title":"Text Comparer","category":"C# Dev Tools"},{"command":"csharp-dev-tools.textAnalyzer","title":"Text Analyzer & Utilities","category":"C# Dev Tools"},{"command":"csharp-dev-tools.stringE