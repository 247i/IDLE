ame":"vscode-jasmine-test-adapter","displayName":"Jasmine Test Explorer","description":"Run your Jasmine tests in the Sidebar of Visual Studio Code","icon":"img/icon.png","author":"Holger Benl <hbenl@evandor.de>","publisher":"hbenl","version":"1.8.3","license":"MIT","homepage":"https://github.com/hbenl/vscode-jasmine-test-adapter","repository":{"type":"git","url":"https://github.com/hbenl/vscode-jasmine-test-adapter.git"},"bugs":{"url":"https://github.com/hbenl/vscode-jasmine-test-adapter/issues"},"categories":["Other"],"keywords":["jasmine","test","testing"],"main":"out/main.js","scripts":{"reinstall":"rimraf node_modules package-lock.json && npm install","clean":"rimraf out vscode-jasmine-test-adapter-*.vsix","build":"tsc","watch":"tsc -w","rebuild":"npm run clean && npm run build","package":"vsce package","publish":"vsce publish"},"extensionDependencies":["hbenl.vscode-test-explorer"],"dependencies":{"escape-string-regexp":"^4.0.0","fs-extra":"^10.1.0","jasmine":"^4.3.0","minimatch":"^5.1.0","stack-trace":"0.0.10","tslib":"^2.4.0","vscode-test-adapter-api":"^1.9.0","vscode-test-adapter-util":"^0.7.1"},"devDependencies":{"@types/fs-extra":"^9.0.13","@types/jasmine":"^4.0.3","@types/minimatch":"^3.0.5","@types/stack-trace":"0.0.30","@types/vscode":"~1.47.0","rimraf":"^3.0.2","typescript":"^4.7.4","vsce":"^2.10.0"},"engines":{"vscode":"^1.47.0"},"activationEvents":["*"],"contributes":{"configuration":{"type":"object","title":"Jasmine Test Explorer","properties":{"jasmineExplorer.cwd":{"description":"The working directory where Jasmine is run (relative to the workspace folder)","type":"string","scope":"resource"},"jasmineExplorer.config":{"description":"The location of the Jasmine config file (relative to the working directory)","type":"string","default":"spec/support/jasmine.json","scope":"resource"},"jasmineExplorer.env":{"description":"Environment variables to be set when running the tests","type":"object","additionalProperties":{"type":"string"},"default":{},"scope":"resource"},"jasmineExplorer.debuggerPort":{"description":"The preferred port to use for debugging sessions","type":"number","default":9229,"scope":"resource"},"jasmineExplorer.nodePath":{"description":"The path to the node executable to use. By default it will attempt to find it on your PATH, if it can't find it or if this option is set to `null`, it will use the one shipped with VS Code","type":["string","null"],"default":"default","scope":"resource"},"jasmineExplorer.nodeArgv":{"description":"The arguments to the node executable to use. To enable typescript support, install the ts-node npm package and set this property to [\"-r\", \"ts-node/register\"]","type":"array","items":{"type":"string"},"scope":"resource"},"jasmineExplorer.jasminePath":{"description":"The path to the jasmine package to use (relative to the workspace folder). By default (or if this option is set to `null`) it uses a bundled version of jasmine, to use the one installed in your project's node_modules folder, set this option to \"node_modules/jasmine\". This is necessary if you want to use the `requires` property in `jasmine.json` to load packages installed locally in your project's `node_modules` folder.","type":["string","null"],"default":"default","scope":"resource"},"jasmineExplorer.debuggerConfig":{"description":"The name of a launch configuration to use for debugging sessions","type":["string","null"],"default":null,"scope":"resource"},"jasmineExplorer.breakOnFirstLine":{"description":"when debugging, inject a breakpoint at the 1st line of the 1st run test","type":"boolean","default":false,"scope":"resource"},"jasmineExplorer.debuggerSkipFiles":{"description":"An array of glob patterns for files to skip when debugging","type":"array","items":{"type":"string"},"scope":"resource"},"jasmineExplorer.logpanel":{"description":"write diagnotic logs to an output panel","type":"boolean","scope":"resource"},"jasmineExplorer.logfile":{"description":"write diagnostic logs to the given file","type":"string","scope":"resource"}}}}},"location":{"$mid":1,"path":"/D:/All/IDLE/t/VSCodium/data/extensions/hbenl.vscode-jasmine-test-adapter-1.8.3-universal","scheme":"file"},"isBuiltin":false,"targetPlatform":"universal","publisherDisplayName":"hbenl","metadata":{"installedTimestamp":1787044303073,"pinned":false,"source":"gallery","id":"1f3c030c-61ba-4573-9acc-8d170753644e","publisherId":"3356f11a-6798-4f03-a93f-3d929b7fca7c","publisherDisplayName":"hbenl","targetPlatform":"universal","updated":false,"private":false,"isPreReleaseVersion":false,"hasPreReleaseVersion":false,"size":1036849},"isValid":true,"validations":[],"preRelease":false,"forceAutoUpdate":false},{"type":1,"identifier":{"id":"icsharpcode.ilspy-vscode","uuid":"e71e3bdc-dd75-4005-bc34-5ef5838c84ad"},"manifest":{"name":"ilspy-vscode","displayName":"ilspy-vscode","description":"Decompile MSIL assemblies - support for full framework, .NET Core and .NET Standard","version":"1.0.0","icon":"resources/ILSpy-vscode-marketplace-icon.png","publisher":"icsharpcode","private":true,"license":"SEE LICENSE","homepage":"https://github.com/icsharpcode/ilspy-vscode/tree/master/vscode-extension","bugs":"https://github.com/icsharpcode/ilspy-vscode/issues","repository":{"type":"git","url":"https://github.com/icsharpcode/ilspy-vscode"},"engines":{"vscode":"^1.110.0"},"categories":["Other"],"activationEvents":["onStartupFinished"],"main":"./dist/extension.js","contributes":{"configuration":[{"title":"ILSpy","properties":{"ilspy.defaultOutputLanguage":{"description":"Defines to which language or language variant ILSpy will decompile assemblies by default. Note that you can choose a different language for a specific view later.","type":"string","default":"C# 14.0 / VS 2026","enum":["C# 14.0 / VS 2026","C# 13.0 / VS 2022.12","C# 12.0 / VS 2022.8","C# 11.0 / VS 2022.4","C# 10.0 / VS 2022","C# 9.0 / VS 2019.8","C# 8.0 / VS 2019","C# 7.3 / VS 2017.7","C# 7.2 / VS 2017.4","C# 7.1 / VS 2017.3","C# 7.0 / VS 2017","C# 6.0 / VS 2015","C# 5.0 / VS 2012","C# 4.0 / VS 2010","C# 3.0 / VS 2008","C# 2.0 / VS 2005","C# 1.0 / VS .NET","IL"],"enumDescriptions":["Decompile to C# 14.0 by default","Decompile to C# 13.0 by default","Decompile to C# 12.0 by default","Decompile to C# 11.0 by default","Decompile to C# 10.0 by default","Decompile to C# 9.0 by default","Decompile to C# 8.0 by default","Decompile to C# 7.3 by default","Decompile to C# 7.2 by default","Decompile to C# 7.1 by default","Decompile to C# 7.0 by default","Decompile to C# 6.0 by default","Decompile to C# 5.0 by default","Decompile to C# 4.0 by default","Decompile to C# 3.0 by default","Decompile to C# 2.0 by default","Decompile to C# 1.0 by default","Decompile to readable IL instructions by default"]},"ilspy.loadPreviousAssemblies":{"description":"If activated, the list of loaded assemblies is stored with current workspace and is restored on re-opening. This doesn't apply for temporarily auto-loaded dependencies.","type":"boolean","default":"true"},"ilspy.autoLoadDependencies":{"description":"If activated, dependency assemblies are temporarily added to assembly tree on demand.","type":"boolean","default":"true"},"ilspy.showCompilerGeneratedSymbols":{"description":"If activated, shows compiler-generated symbols.","type":"boolean","default":"false"}}}],"viewsContainers":{"panel":[{"id":"ilspySearchResultsContainer","title":"ILSpy: Search Results","icon":"resources/il-spy-modern-icon.svg"},{"id":"ilspyAnalyzeResultsContainer","title":"ILSpy: Analyze","icon":"resources/il-spy-modern-icon.svg"}]},"views":{"explorer":[{"id":"ilspyDecompiledMembers","name":"ILSpy: Assemblies","when":"ilspy.backendAvailable","icon":"resources/il-spy-modern-icon.svg"}],"ilspySearchResultsContainer":[{"id":"ilspySearchResultsContainer","name":"ILSpy: Search Results","when":"ilspy.searchResultsToShow","icon":"resources/il-spy-modern-icon.svg"}],"ilspyAnalyzeResultsContainer":[{"id":"ilspyAnalyzeResultsContainer","name":"ILSpy: Analyze","when":"ilspy.analyzeResultsToShow","icon":"resources/il-spy-modern-icon.svg"}]},"viewsWelcome":[{"view":"ilspyDecompiledMembers","contents":"No assemblies selected yet\n[Add assembly from workspace](command:ilspy.decompileAssemblyInWorkspace)\n[Pick assembly from file system](command:ilspy.decompileAssemblyViaDialog)\n\nTake the [Feature Tour](https://github.com/icsharpcode/ilspy-vscode/wiki/Feature-Tour)","when":"ilspy.backendAvailable"}],"commands":[{"command":"ilspy.decompileSelectedAssembly","title":"Decompile selected assembly","category":"ILSpy"},{"command":"ilspy.decompileAssemblyInWorkspace","title":"Add assembly or package from workspace","category":"ILSpy"},{"command":"ilspy.decompileAssemblyViaDialog","title":"Pick assembly or package from file system","category":"ILSpy"},{"command":"ilspy.unloadAssembly","title":"Unload","category":"ILSpy","icon":"$(close)"},{"command":"ilspy.reloadAssembly","title":"Reload","category":"ILSpy","icon":"$(refresh)"},{"command":"ilspy.selectOutputLanguage","title":"Select output language","category":"ILSpy"},{"command":"ilspy.search","title":"Search in Decompiled Assemblies","category":"ILSpy","icon":"$(search-view-icon)"},{"command":"ilspy.searchEditorSelection","title":"Search with ILSpy","category":"ILSpy","icon":"$(search-view-icon)"},{"command":"ilspy.analyze","title":"Analyze Element","category":"ILSpy","icon":"$(search-view-icon)"},{"command":"ilspy.export","title":"Export Decompiled Code...","category":"ILSpy","icon":"$(save-all)"}],"menus":{"explorer/context":[{"command":"ilspy.decompileSelectedAssembly","group":"navigation","when":"resourceExtname == .dll || resourceExtname == .exe || resourceExtname == .winmd || resourceExtname == .netmodule || resourceExtname == .wasm"}],"editor/context":[{"command":"ilspy.searchEditorSelection","when":"ilspy.backendAvailable && ilspy.treeWithNodes"}],"view/title":[{"submenu":"ilspy/view/assemblytree/add","when":"view == ilspyDecompiledMembers","group":"navigation"},{"command":"ilspy.search","when":"view == ilspyDecompiledMembers && ilspy.treeWithNodes","group":"navigation"}],"ilspy/view/assemblytree/add":[{"command":"ilspy.decompileAssemblyInWorkspace","when":"view == ilspyDecompiledMembers"},{"command":"ilspy.decompileAssemblyViaDialog","when":"view == ilspyDecompiledMembers"}],"view/item/context":[{"command":"ilspy.analyze","when":"(view == ilspyDecompiledMembers || view == ilspySearchResultsContainer || view == ilspyAnalyzeResultsContainer) && viewItem =~ /#analyze/","group":"assembly@0"},{"command":"ilspy.reloadAssembly","when":"view == ilspyDecompiledMembers && viewItem =~ /#manageRootEntries/","group":"assembly@1"},{"command":"ilspy.export","when":"view == ilspyDecompiledMembers && viewItem =~ /#export/","group":"assembly@2"},{"command":"ilspy.unloadAssembly","when":"view == ilspyDecompiledMembers && viewItem =~ /#manageRootEntries/","group":"assembly@3"},{"command":"ilspy.analyze","when":"(view == ilspyDecompiledMembers || view == ilspySearchResultsContainer || view == ilspyAnalyzeResultsContainer) && viewItem =~ /#analyze/","group":"inline@0"},{"command":"ilspy.reloadAssembly","when":"view == ilspyDecompiledMembers && viewItem =~ /#manageRootEntries/","group":"inline@1"},{"command":"ilspy.export","when":"view == ilspyDecompiledMembers && viewItem =~ /#export/","group":"inline@2"},{"command":"ilspy.unloadAssembly","when":"view == ilspyDecompiledMembers && viewItem =~ /#manageRootEntries/","group":"inline@3"}],"commandPalette":[{"command":"ilspy.decompileAssemblyInWorkspace","when":"ilspy.backendAvailable"},{"command":"ilspy.decompileAssemblyViaDialog","when":"ilspy.backendAvailable"},{"command":"ilspy.selectOutputLanguage","when":"resourceScheme == ilspy"},{"command":"ilspy.search","when":"ilspy.backendAvailable && ilspy.treeWithNodes"},{"command":"ilspy.decompileSelectedAssembly","when":"false"},{"command":"ilspy.searchEditorSelection","when":"false"},{"command":"ilspy.analyze","when":"false"},{"command":"ilspy.reloadAssembly","when":"false"},{"command":"ilspy.unloadAssembly","when":"false"},{"command":"ilspy.export","when":"false"}]},"submenus":[{"id":"ilspy/view/assemblytree/add","label":"Add Assembly","icon":"$(add)"}],"colors":[{"id":"ilspy.autoLoadedAssemblyTextForeground","description":"Text color of auto-loaded assemblies","defaults":{"dark":"#4682B4","light":"#4682B4","highContrast":"#4682B4"}}],"languageModelTools":[{"name":"add_loaded_assembly","tags":["ilspy","assemblies","load"],"toolReferenceName":"ilspy-add-assembly","displayName":"Add assembly or NuGet package to ILSpy","modelDescription":"Adds one assembly or NuGet package file to the set of assemblies currently loaded in ILSpy so that it can be searched, analyzed, decompiled, and exported.","userDescription":"Add one assembly or NuGet package file to ILSpy","canBeReferencedInPrompt":true,"icon":"$(add)","inputSchema":{"type":"object","required":["assemblyPath"],"properties":{"assemblyPath":{"type":"string","description":"Absolute file system path of the assembly to add to ILSpy"}}}},{"name":"remove_loaded_assembly","tags":["ilspy","assemblies","unload"],"toolReferenceName":"ilspy-remove-assembly","displayName":"Remove assembly or NuGet package from ILSpy","modelDescription":"Removes one currently loaded assembly or NuGet package from ILSpy. Prefer assemblyPath for exact targeting; assemblyName can be used when it uniquely identifies a loaded assembly.","userDescription":"Remove one loaded assembly or NuGet package from ILSpy","canBeReferencedInPrompt":true,"icon":"$(close)","inputSchema":{"type":"object","properties":{"assemblyPath":{"type":"string","description":"Absolute file system path of the loaded assembly or NuGet package to remove"},"assemblyName":{"type":"string","description":"Assembly file name or simple assembly name to remove when it is unique among loaded assemblies"}}}},{"name":"list_loaded_assemblies","tags":["ilspy","assemblies"],"toolReferenceName":"ilspy-list-assemblies","displayName":"List loaded ILSpy assemblies","modelDescription":"Returns the assemblies or NuGet packages currently loaded in ILSpy, including their names and full paths. Use this before decompilation or analysis when you need to know what ILSpy can already inspect.","userDescription":"List the assemblies or NuGet packages currently loaded in ILSpy","canBeReferencedInPrompt":true,"icon":"$(files)","inputSchema":{"type":"object","properties":{}}},{"name":"decompile_symbol","tags":["ilspy","decompile"],"toolReferenceName":"ilspy-decompile-symbol","displayName":"Decompile symbol with ILSpy","modelDescription":"Searches the currently loaded ILSpy assemblies for a .NET symbol such as a type, member, or namespace, then returns the decompiled source code for the matching symbol or symbols. Use assemblyPath or assemblyName to disambiguate when the same symbol exists in multiple assemblies.","userDescription":"Decompile a .NET symbol from the assemblies currently loaded in ILSpy","canBeReferencedInPrompt":true,"icon":"$(files)","inputSchema":{"type":"object","required":["symbol"],"properties":{"symbol":{"type":"string","description":"Name of the .NET symbol to decompile. A fully qualified name is preferred when available"},"assemblyPath":{"type":"string","description":"Optional absolute assembly path used to narrow the symbol search to one loaded assembly"},"assemblyName":{"type":"string","description":"Optional assembly file name or simple assembly name used to narrow the symbol search"},"outputLanguage":{"type":"string","description":"Optional ILSpy output language. When omitted, the extension's current default output language is used"}}}},{"name":"decompile_node","tags":["ilspy","decompile","tree","nodes"],"toolReferenceName":"ilspy-decompile-node","displayName":"Decompile ILSpy tree node","modelDescription":"Decompiles one specific ILSpy tree node using its exact nodeMetadata payload. Use this when you already have a concrete node from list_nodes or another ILSpy tool result, especially for non-symbol nodes such as references, resources, or other tree entries that are not best addressed by symbol search.","userDescription":"Decompile one specific ILSpy tree node","canBeReferencedInPrompt":true,"icon":"$(files)","inputSchema":{"type":"object","required":["nodeMetadata"],"properties":{"nodeMetadata":{"type":"object","description":"Exact ILSpy node metadata, typically copied verbatim from the nodeMetadata field returned by list_nodes or another ILSpy tool result","required":["assemblyPath","type","name","symbolToken","parentSymbolToken","availableCommands"],"properties":{"assemblyPath":{"type":"string","description":"Assembly path associated with the node"},"type":{"type":"integer","description":"Numeric ILSpy node type enum value"},"name":{"type":"string","description":"Node name from ILSpy metadata"},"bundledAssemblyName":{"type":"string","description":"Optional bundled assembly name for package-backed nodes"},"symbolToken":{"type":"integer","description":"Node symbol token from ILSpy metadata"},"parentSymbolToken":{"type":"integer","description":"Parent symbol token from ILSpy metadata"},"subType":{"type":"string","description":"Optional ILSpy node subtype"},"availableCommands":{"type":"integer","description":"Bitmask of commands ILSpy reports as available for the node"}}},"outputLanguage":{"type":"string","description":"Optional ILSpy output language. When omitted, the extension's current default output language is used"}}}},{"name":"list_nodes","tags":["ilspy","tree","nodes"],"toolReferenceName":"ilspy-list-nodes","displayName":"List ILSpy nodes","modelDescription":"Lists nodes from ILSpy's assembly tree. With no input it returns the root nodes, which are usually the loaded assemblies. Prefer passing exact nodeMetadata from a prior list_nodes result to navigate to the next level of any tree node. Symbol or assembly inputs are still supported as shortcuts for choosing the first target. Results include exact nodeMetadata for further tree navigation or decompilation.","userDescription":"List ILSpy assembly tree nodes","canBeReferencedInPrompt":true,"icon":"$(list-tree)","inputSchema":{"type":"object","properties":{"nodeMetadata":{"type":"object","description":"Exact ILSpy node metadata, typically copied verbatim from the nodeMetadata field returned by list_nodes or another ILSpy tool result. Prefer this for navigating deeper into the tree from any node type.","required":["assemblyPath","type","name","symbolToken","parentSymbolToken","availableCommands"],"properties":{"assemblyPath":{"type":"string","description":"Assembly path associated with the node"},"type":{"type":"integer","description":"Numeric ILSpy node type enum value"},"name":{"type":"string","description":"Node name from ILSpy metadata"},"bundledAssemblyName":{"type":"string","description":"Optional bundled assembly name for package-backed nodes"},"symbolToken":{"type":"integer","description":"Node symbol token from ILSpy metadata"},"parentSymbolToken":{"type":"integer","description":"Parent symbol token from ILSpy metadata"},"subType":{"type":"string","description":"Optional ILSpy node subtype"},"availableCommands":{"type":"integer","description":"Bitmask of commands ILSpy reports as available for the node"}}},"symbol":{"type":"string","description":"Optional symbol whose direct children should be listed when nodeMetadata is not provided"},"assemblyPath":{"type":"string","description":"Optional absolute assembly path whose direct child nodes should be listed, or used to disambiguate a symbol when nodeMetadata is not provided"},"assemblyName":{"type":"string","description":"Optional assembly file name or simple assembly name whose direct child nodes should be listed, or used to disambiguate a symbol when nodeMetadata is not provided"}}}},{"name":"search_decompiled_symbols","tags":["ilspy","search","symbols"],"toolReferenceName":"ilspy-search-symbols","displayName":"Search loaded ILSpy symbols","modelDescription":"Searches the symbols in assemblies currently loaded in ILSpy and returns matching nodes with type, assembly path, display information, and exact nodeMetadata. Use it to discover exact symbol names before decompiling or analyzing them, or to obtain nodeMetadata for decompile_node.","userDescription":"Search the symbols in assemblies currently loaded in ILSpy","canBeReferencedInPrompt":true,"icon":"$(search-view-icon)","inputSchema":{"type":"object","required":["term"],"properties":{"term":{"type":"string","description":"Text to search for in loaded assemblies"},"assemblyPath":{"type":"string","description":"Optional absolute assembly path used to restrict the search to one loaded assembly"},"assemblyName":{"type":"string","description":"Optional assembly file name or simple assembly name used to restrict the search"}}}},{"name":"analyze_symbol","tags":["ilspy","analyze"],"toolReferenceName":"ilspy-analyze-symbol","displayName":"Analyze symbol with ILSpy","modelDescription":"Runs ILSpy's analyze request for a loaded symbol or assembly and returns the resulting analyzer nodes. Use it to inspect usages, derived types, base types, or other analysis views exposed by ILSpy.","userDescription":"Analyze a loaded symbol or assembly with ILSpy","canBeReferencedInPrompt":true,"icon":"$(search-view-icon)","inputSchema":{"type":"object","properties":{"symbol":{"type":"string","description":"Optional symbol to analyze. If omitted, assemblyPath or assemblyName must identify a loaded assembly"},"assemblyPath":{"type":"string","description":"Optional absolute assembly path used to target or disambiguate the analysis request"},"assemblyName":{"type":"string","description":"Optional assembly file name or simple assembly name used to target or disambiguate the analysis request"}}}},{"name":"export_decompiled_code","tags":["ilspy","export","decompile"],"toolReferenceName":"ilspy-export-code","displayName":"Export decompiled ILSpy code","modelDescription":"Exports the decompiled output of a loaded ILSpy node to a directory on disk. The target can be an assembly or another exportable symbol. Use assemblyPath or assemblyName to target a loaded assembly directly, or provide a symbol and optionally narrow it by assembly.","userDescription":"Export decompiled ILSpy output to a directory on disk","canBeReferencedInPrompt":true,"icon":"$(export)","inputSchema":{"type":"object","required":["outputDirectory"],"properties":{"symbol":{"type":"string","description":"Optional export target symbol. If omitted, assemblyPath or assemblyName must identify a loaded assembly"},"assemblyPath":{"type":"string","description":"Optional absolute assembly path used to target or disambiguate the export"},"assemblyName":{"type":"string","description":"Optional assembly file name or simple assembly name used to target or disambiguate the export"},"outputDirectory":{"type":"string","description":"Absolute path of the directory where ILSpy should write the exported files"},"outputLanguage":{"type":"string","description":"Optional ILSpy output language. When omitted, the extension's current default output language is used"},"includeCompilerGenerated":{"type":"boolean","description":"Optional override for whether compiler-generated members should be included in the export"}}}}],"languages":[{"id":"ilspy-code-cs","aliases":["ILSpy (C#)"],"icon":{"light":"resources/il-spy-modern-icon.svg","dark":"resources/il-spy-modern-icon-dark.svg"}},{"id":"ilspy-code-il","aliases":["ILSpy (IL)"],"icon":{"light":"resources/il-spy-modern-icon.svg","dark":"resources/il-spy-modern-icon-dark.svg"}}],"grammars":[{"language":"ilspy-code-cs","scopeName":"source.ilspy-code-cs","path":"resources/ilspy-code-cs.tmLanguage.json"}]},"scripts":{"vscode:prepublish":"pnpm package","package":"webpack --mode production --devtool hidden-source-map","build:vsix":"vsce package --no-dependencies","compile":"webpack --mode development","watch":"webpack --mode development --watch","pretest":"pnpm compile && pnpm lint","lint":"eslint src --ext ts","test":"node ./out/test/runTest.js","test:unit":"vitest 