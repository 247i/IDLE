{
  "git.autofetch": true,
  "git.enableSmartCommit": true,
  "workbench.startupEditor": "none",
  "rgbEverywhere.target.auxiliarybar": false,
  "rgbEverywhere.target.breadcrumbs": false,
  "rgbEverywhere.target.editor": false,
  "rgbEverywhere.target.menubar": false,
  "rgbEverywhere.target.titlebar": false,
  "rgbEverywhere.target.tabs": false,
  "rgbEverywhere.target.statusbar": false,
  "rgbEverywhere.target.sidebar": false,
  "rgbEverywhere.target.panel": false,
  "debug.inlineValues": false,
  "workbench.colorTheme": "Dark+",
  "security.workspace.trust.untrustedFiles": "open",
  "workbench.editor.empty.hint": "hidden",
  "resharper.region.region": "Asia",
  "resharper.dataSharing.allowDataSharing": false,
  "editor.formatOnSave": true,
  "notebook.formatOnSave.enabled": true,
  "prettyxml.settings.formatOnSave": true,
  "editor.semanticTokenColorCustomizations": {
    "rules": {
      "interface": {
        "foreground": "#b8ce82",
      },
      "namespace": "#cccccc",
      "enum": "#b8ce82",
      "struct": {
        "foreground": "#86C691",
      },
      "inactive": {
        "foreground": "#6A6A6A",
      },
    },
  },
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": "entity.name.type.interface.cs",
        "settings": {
          "foreground": "#b8ce82",
        },
      },
      {
        "scope": "entity.name.type.enum.cs",
        "settings": {
          "foreground": "#b8ce82",
        },
      },
      {
        "scope": "entity.name.type.struct.cs",
        "settings": {
          "foreground": "#86C691",
        },
      },
      {
        "scope": "variable.other.enummember.cs",
        "settings": {
          "foreground": "#4FC1FF",
        },
      },
    ],
  },
  "diffEditor.maxComputationTime": 0,
}
